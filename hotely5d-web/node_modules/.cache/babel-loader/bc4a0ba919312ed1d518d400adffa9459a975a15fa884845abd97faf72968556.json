{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { findRoomByIdAPI } from '@/api/room';\nimport { addAppointmentAPI } from '@/api/appointment';\nimport { mapState } from 'vuex';\nimport dayjs from 'dayjs';\nexport default {\n  name: 'FrontCategoryDetails',\n  data() {\n    return {\n      pickerOptions: {\n        disabledDate: this.disabledDate\n      },\n      room: {},\n      category: {},\n      form: {\n        roomId: this.$route.params.id,\n        startTime: null,\n        days: null\n      },\n      timeArr: null\n    };\n  },\n  computed: {\n    ...mapState(['user', 'role', 'token'])\n  },\n  async mounted() {\n    const {\n      data\n    } = await findRoomByIdAPI(this.$route.params.id);\n    this.room = data;\n    this.category = data.category;\n  },\n  methods: {\n    disabledDate(time) {\n      //禁用今天之前的日期\n      if (dayjs(time).isBefore(dayjs(), 'day')) {\n        return true;\n      }\n      //禁用其它日期\n      return this.room.notUseDateList.includes(dayjs(time).format('YYYY-MM-DD'));\n    },\n    //预订\n    async handleAppointment() {\n      if (!this.token) {\n        this.$message({\n          type: 'error',\n          message: '请先登录！'\n        });\n        setTimeout(() => this.$router.push('/login'), 1000);\n        return;\n      }\n      if (null == this.form.startTime || this.form.startTime == '') {\n        this.$message({\n          type: 'error',\n          message: '请选择入住时间！'\n        });\n        return;\n      }\n      if (null == this.form.days || this.form.days == '') {\n        this.$message({\n          type: 'error',\n          message: '请选择居住天数！'\n        });\n        return;\n      }\n      const res = await addAppointmentAPI({\n        ...this.form,\n        startTime: this.form.startTime + \" 00:00:00\"\n      });\n      this.$message({\n        message: res.message,\n        type: res.flag ? \"success\" : \"error\"\n      });\n      if (res.flag) {\n        this.$router.push(\"/front/room\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["findRoomByIdAPI","addAppointmentAPI","mapState","dayjs","name","data","pickerOptions","disabledDate","room","category","form","roomId","$route","params","id","startTime","days","timeArr","computed","mounted","methods","time","isBefore","notUseDateList","includes","format","handleAppointment","token","$message","type","message","setTimeout","$router","push","res","flag"],"sources":["src/views/front/RoomDetails.vue"],"sourcesContent":["<template>\r\n    <el-card class=\"box-card\">\r\n        <div slot=\"header\" class=\"clearfix\">\r\n            <span>客房详情</span>\r\n        </div>\r\n        <div class=\"page-container\">\r\n            <div class=\"left-section\">\r\n                <img :src=\"$baseFileUrl + category.photo\" class=\"hotel-img\">\r\n            </div>\r\n            <div class=\"right-section\">\r\n                <el-descriptions class=\"margin-top\" :column=\"1\" border>\r\n                    <el-descriptions-item>\r\n                        <template slot=\"label\">\r\n                            <i class=\"el-icon-office-building\"></i>\r\n                            房型\r\n                        </template>\r\n                        {{ category.categoryName }}\r\n                    </el-descriptions-item>\r\n                    <el-descriptions-item>\r\n                        <template slot=\"label\">\r\n                            <i class=\"el-icon-user\"></i>\r\n                            房号\r\n                        </template>\r\n                        {{ room.roomNum }}\r\n                    </el-descriptions-item>\r\n                    <el-descriptions-item>\r\n                        <template slot=\"label\">\r\n                            <i class=\"el-icon-mobile-phone\"></i>\r\n                            价格\r\n                        </template>\r\n                        {{ category.price }}\r\n                    </el-descriptions-item>\r\n                    <el-descriptions-item>\r\n                        <template slot=\"label\">\r\n                            <i class=\"el-icon-location-outline\"></i>\r\n                            可住人数\r\n                        </template>\r\n                        {{ category.liveNum }}\r\n                    </el-descriptions-item>\r\n                    <el-descriptions-item>\r\n                        <template slot=\"label\">\r\n                            <i class=\"el-icon-tickets\"></i>\r\n                            床位数\r\n                        </template>\r\n                        {{ category.bedNum }}\r\n                    </el-descriptions-item>\r\n                    <el-descriptions-item>\r\n                        <template slot=\"label\">\r\n                            <i class=\"el-icon-office-building\"></i>\r\n                            面积\r\n                        </template>\r\n                        {{ category.area }}平方\r\n                    </el-descriptions-item>\r\n                    <el-descriptions-item>\r\n                        <template slot=\"label\">\r\n                            <i class=\"el-icon-office-building\"></i>\r\n                            今日状态\r\n                        </template>\r\n                        <el-tag v-if=\"room.canUse\" type=\"success\">可预订</el-tag>\r\n                        <el-tag v-else type=\"danger\">已满房</el-tag>\r\n                    </el-descriptions-item>\r\n                    <el-descriptions-item>\r\n                        <template slot=\"label\">\r\n                            <i class=\"el-icon-location-outline\"></i>\r\n                            介绍\r\n                        </template>\r\n                        {{ category.introduce }}\r\n                    </el-descriptions-item>\r\n                </el-descriptions>\r\n                <p v-if=\"!token\" class=\"text-red\">温馨提示：请登录后再预订</p>\r\n                <el-form inline ref=\"form\" :model=\"form\" class=\"my-10\">\r\n                    <el-form-item>\r\n                        <el-date-picker size=\"mini\" :clearable=\"false\" :picker-options=\"pickerOptions\" v-model=\"form.startTime\"\r\n                        type=\"date\" placeholder=\"入住日期\" value-format=\"yyyy-MM-dd\" format=\"yyyy-MM-dd\">\r\n                    </el-date-picker>\r\n                    </el-form-item>\r\n                    <el-form-item>\r\n                       <el-input type=\"number\" min=\"1\" placeholder=\"居住天数\" size=\"mini\" v-model=\"form.days\"></el-input>\r\n                    </el-form-item>\r\n                    <el-form-item>\r\n                        <el-button size=\"mini\" v-if=\"role != 1\" class=\"ml-10\" @click=\"handleAppointment\" type=\"primary\">预订</el-button>\r\n                    </el-form-item>\r\n                </el-form>\r\n            </div>\r\n        </div>\r\n\r\n    </el-card>\r\n</template>\r\n\r\n<script>\r\nimport { findRoomByIdAPI } from '@/api/room'\r\nimport { addAppointmentAPI } from '@/api/appointment'\r\nimport { mapState } from 'vuex'\r\nimport dayjs from 'dayjs'\r\nexport default {\r\n    name: 'FrontCategoryDetails',\r\n\r\n    data() {\r\n        return {\r\n            pickerOptions: {\r\n                disabledDate: this.disabledDate\r\n            },\r\n            room: {},\r\n            category: {},\r\n            form: {\r\n                roomId: this.$route.params.id,\r\n                startTime: null,\r\n                days: null\r\n            },\r\n            timeArr: null\r\n        };\r\n    },\r\n\r\n    computed: {\r\n        ...mapState(['user', 'role', 'token'])\r\n    },\r\n\r\n    async mounted() {\r\n        const { data } = await findRoomByIdAPI(this.$route.params.id)\r\n        this.room = data\r\n        this.category = data.category\r\n    },\r\n\r\n    methods: {\r\n        disabledDate(time) {\r\n            //禁用今天之前的日期\r\n            if(dayjs(time).isBefore(dayjs(), 'day')){\r\n                return true\r\n            }\r\n            //禁用其它日期\r\n            return this.room.notUseDateList.includes(dayjs(time).format('YYYY-MM-DD') )\r\n        },\r\n        //预订\r\n        async handleAppointment() {\r\n            if (!this.token) {\r\n                this.$message({ type: 'error', message: '请先登录！' })\r\n                setTimeout(() => this.$router.push('/login'), 1000)\r\n                return\r\n            }\r\n            if (null == this.form.startTime || this.form.startTime == '') {\r\n                this.$message({ type: 'error', message: '请选择入住时间！' })\r\n                return\r\n            }\r\n            if (null == this.form.days || this.form.days == '') {\r\n                this.$message({ type: 'error', message: '请选择居住天数！' })\r\n                return\r\n            }\r\n            const res = await addAppointmentAPI({\r\n                ...this.form,\r\n                startTime: this.form.startTime+\" 00:00:00\"\r\n            })\r\n            this.$message({\r\n                message: res.message,\r\n                type: res.flag ? \"success\" : \"error\",\r\n            });\r\n            if(res.flag){\r\n                this.$router.push(\"/front/room\")\r\n            }\r\n            \r\n        }\r\n    },\r\n};\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.box-card {\r\n    width: 1200px;\r\n    margin: 20px auto;\r\n}\r\n\r\n.page-container {\r\n    display: flex;\r\n\r\n    .left-section {\r\n        min-height: 500px;\r\n        padding: 14px;\r\n\r\n        .hotel-img {\r\n            width: 80%;\r\n            height: 300px;\r\n\r\n        }\r\n    }\r\n\r\n    .right-section {\r\n        padding: 14px;\r\n        flex: 1;\r\n    }\r\n}\r\n</style>"],"mappings":";AA0FA,SAAAA,eAAA;AACA,SAAAC,iBAAA;AACA,SAAAC,QAAA;AACA,OAAAC,KAAA;AACA;EACAC,IAAA;EAEAC,KAAA;IACA;MACAC,aAAA;QACAC,YAAA,OAAAA;MACA;MACAC,IAAA;MACAC,QAAA;MACAC,IAAA;QACAC,MAAA,OAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;QACAC,SAAA;QACAC,IAAA;MACA;MACAC,OAAA;IACA;EACA;EAEAC,QAAA;IACA,GAAAhB,QAAA;EACA;EAEA,MAAAiB,QAAA;IA