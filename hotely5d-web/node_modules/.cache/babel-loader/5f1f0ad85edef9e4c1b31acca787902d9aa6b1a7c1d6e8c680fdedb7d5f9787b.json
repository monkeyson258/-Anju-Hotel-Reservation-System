{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapState, mapMutations } from 'vuex';\nimport { removeToken } from '@/utils/auth';\nconst TITLE_MAP = {\n  '/admin': '工作台',\n  '/admin/statistics': '数据统计',\n  '/admin/intelligence': '数智决策',\n  '/admin/admin': '管理员管理',\n  '/admin/member': '用户管理',\n  '/admin/category': '房型管理',\n  '/admin/room': '房间管理',\n  '/admin/appointment': '预约管理',\n  '/admin/orders': '入住管理',\n  '/admin/message': '留言管理',\n  '/admin/notice': '公告管理',\n  '/admin/adminInfo': '个人信息',\n  '/admin/addOrders': '新增入住'\n};\nexport default {\n  name: 'AdminLayout',\n  computed: {\n    ...mapState(['user']),\n    activeMenu() {\n      return this.$route.path;\n    },\n    pageTitle() {\n      return TITLE_MAP[this.$route.path] || '管理后台';\n    },\n    avatarText() {\n      const name = this.user?.name || '管';\n      return name.charAt(0);\n    }\n  },\n  data() {\n    return {\n      isCollapse: false\n    };\n  },\n  methods: {\n    ...mapMutations(['setUser', 'setToken']),\n    handleCommand(cmd) {\n      if (cmd === 'profile') {\n        this.$router.push('/admin/adminInfo');\n      } else if (cmd === 'logout') {\n        this.logout();\n      }\n    },\n    logout() {\n      this.$confirm('确认退出登录吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        removeToken();\n        this.setUser({});\n        this.setToken('');\n        this.$router.replace('/front');\n      }).catch(() => {});\n    }\n  }\n};","map":{"version":3,"names":["mapState","mapMutations","removeToken","TITLE_MAP","name","computed","activeMenu","$route","path","pageTitle","avatarText","user","charAt","data","isCollapse","methods","handleCommand","cmd","$router","push","logout","$confirm","confirmButtonText","cancelButtonText","type","then","setUser","setToken","replace","catch"],"sources":["src/views/AdminLayout.vue"],"sourcesContent":["<template>\r\n  <div :class=\"['admin-layout', isCollapse ? 'sidebar-collapsed' : 'sidebar-expanded']\">\r\n    <aside class=\"sidebar\">\r\n      <div class=\"sidebar-brand\" @click=\"$router.push('/admin')\">\r\n        <img src=\"@/assets/logo.png\" class=\"brand-logo\" alt=\"logo\" />\r\n        <div v-show=\"!isCollapse\" class=\"brand-text\">\r\n          <span class=\"brand-name\">{{ $sysTitle }}</span>\r\n          <span class=\"brand-sub\">管理控制台</span>\r\n        </div>\r\n      </div>\r\n\r\n      <el-scrollbar class=\"sidebar-scroll\">\r\n        <el-menu\r\n          :collapse=\"isCollapse\"\r\n          :default-active=\"activeMenu\"\r\n          :collapse-transition=\"false\"\r\n          background-color=\"transparent\"\r\n          text-color=\"rgba(255,255,255,0.72)\"\r\n          active-text-color=\"#e2cc8a\"\r\n          router\r\n          class=\"sidebar-menu\"\r\n        >\r\n          <el-menu-item index=\"/admin\">\r\n            <i class=\"el-icon-s-home\"></i>\r\n            <span slot=\"title\">工作台</span>\r\n          </el-menu-item>\r\n\r\n          <el-submenu index=\"group-data\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-data-analysis\"></i>\r\n              <span>数据看板</span>\r\n            </template>\r\n            <el-menu-item index=\"/admin/statistics\">\r\n              <i class=\"el-icon-s-data\"></i>\r\n              <span slot=\"title\">数据统计</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/admin/intelligence\">\r\n              <i class=\"el-icon-cpu\"></i>\r\n              <span slot=\"title\">数智决策</span>\r\n            </el-menu-item>\r\n          </el-submenu>\r\n\r\n          <el-submenu index=\"group-ops\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-s-cooperation\"></i>\r\n              <span>运营管理</span>\r\n            </template>\r\n            <el-menu-item index=\"/admin/appointment\">\r\n              <i class=\"el-icon-s-flag\"></i>\r\n              <span slot=\"title\">预约管理</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/admin/orders\">\r\n              <i class=\"el-icon-s-order\"></i>\r\n              <span slot=\"title\">入住管理</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/admin/category\">\r\n              <i class=\"el-icon-s-promotion\"></i>\r\n              <span slot=\"title\">房型管理</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/admin/room\">\r\n              <i class=\"el-icon-office-building\"></i>\r\n              <span slot=\"title\">房间管理</span>\r\n            </el-menu-item>\r\n          </el-submenu>\r\n\r\n          <el-submenu index=\"group-sys\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-setting\"></i>\r\n              <span>系统管理</span>\r\n            </template>\r\n            <el-menu-item index=\"/admin/admin\">\r\n              <i class=\"el-icon-user\"></i>\r\n              <span slot=\"title\">管理员</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/admin/member\">\r\n              <i class=\"el-icon-user-solid\"></i>\r\n              <span slot=\"title\">用户管理</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/admin/notice\">\r\n              <i class=\"el-icon-bell\"></i>\r\n              <span slot=\"title\">公告管理</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/admin/message\">\r\n              <i class=\"el-icon-chat-dot-round\"></i>\r\n              <span slot=\"title\">留言管理</span>\r\n            </el-menu-item>\r\n          </el-submenu>\r\n        </el-menu>\r\n      </el-scrollbar>\r\n\r\n      <div v-show=\"!isCollapse\" class=\"sidebar-footer\">\r\n        <span>斌安居酒店管理系统</span>\r\n      </div>\r\n    </aside>\r\n\r\n    <div class=\"main-area\">\r\n      <header class=\"topbar\">\r\n        <div class=\"topbar-left\">\r\n          <button class=\"collapse-btn\" @click=\"isCollapse = !isCollapse\">\r\n            <i :class=\"isCollapse ? 'el-icon-s-unfold' : 'el-icon-s-fold'\"></i>\r\n          </button>\r\n          <div class=\"breadcrumb\">\r\n            <span class=\"breadcrumb-root\">管理后台</span>\r\n            <i class=\"el-icon-arrow-right\"></i>\r\n            <span class=\"breadcrumb-current\">{{ pageTitle }}</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"topbar-right\">\r\n          <el-dropdown trigger=\"click\" @command=\"handleCommand\">\r\n            <div class=\"user-block\">\r\n              <div class=\"user-avatar\">{{ avatarText }}</div>\r\n              <span class=\"user-name\">{{ user.name || '管理员' }}</span>\r\n              <i class=\"el-icon-arrow-down\"></i>\r\n            </div>\r\n            <el-dropdown-menu slot=\"dropdown\">\r\n              <el-dropdown-item command=\"profile\" icon=\"el-icon-s-custom\">个人信息</el-dropdown-item>\r\n              <el-dropdown-item command=\"logout\" icon=\"el-icon-switch-button\" divided>退出登录</el-dropdown-item>\r\n            </el-dropdown-menu>\r\n          </el-dropdown>\r\n        </div>\r\n      </header>\r\n\r\n      <main class=\"main-content\">\r\n        <router-view />\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapMutations } from 'vuex'\r\nimport { removeToken } from '@/utils/auth'\r\n\r\nconst TITLE_MAP = {\r\n  '/admin': '工作台',\r\n  '/admin/statistics': '数据统计',\r\n  '/admin/intelligence': '数智决策',\r\n  '/admin/admin': '管理员管理',\r\n  '/admin/member': '用户管理',\r\n  '/admin/category': '房型管理',\r\n  '/admin/room': '房间管理',\r\n  '/admin/appointment': '预约管理',\r\n  '/admin/orders': '入住管理',\r\n  '/admin/message': '留言管理',\r\n  '/admin/notice': '公告管理',\r\n  '/admin/adminInfo': '个人信息',\r\n  '/admin/addOrders': '新增入住'\r\n}\r\n\r\nexport default {\r\n  name: 'AdminLayout',\r\n  computed: {\r\n    ...mapState(['user']),\r\n    activeMenu() {\r\n      return this.$route.path\r\n    },\r\n    pageTitle() {\r\n      return TITLE_MAP[this.$route.path] || '管理后台'\r\n    },\r\n    avatarText() {\r\n      const name = this.user?.name || '管'\r\n      return name.charAt(0)\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      isCollapse: false\r\n    }\r\n  },\r\n  methods: {\r\n    ...mapMutations(['setUser', 'setToken']),\r\n    handleCommand(cmd) {\r\n      if (cmd === 'profile') {\r\n        this.$router.push('/admin/adminInfo')\r\n      } else if (cmd === 'logout') {\r\n        this.logout()\r\n      }\r\n    },\r\n    logout() {\r\n      this.$confirm('确认退出登录吗?', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        removeToken()\r\n        this.setUser({})\r\n        this.setToken('')\r\n        this.$router.replace('/front')\r\n      }).catch(() => {})\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n@sidebar-w: 240px;\r\n@sidebar-collapsed-w: 64px;\r\n@gold: #c9a962;\r\n@gold-light: #e2cc8a;\r\n\r\n.admin-layout {\r\n  min-height: 100vh;\r\n  background: var(--hotel-bg, #f0f2f5);\r\n}\r\n\r\n.sidebar {\r\n  position: fixed;\r\n  left: 0;\r\n  top: 0;\r\n  height: 100vh;\r\n  z-index: 1001;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: linear-gradient(180deg, #141820 0%, #1a2030 50%, #141820 100%);\r\n  border-right: 1px solid rgba(201, 169, 98, 0.12);\r\n  box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);\r\n  transition: width 0.28s cubic-bezier(0.4, 0, 0.2, 1);\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar-expanded .sidebar { width: @sidebar-w; }\r\n.sidebar-collapsed .sidebar { width: @sidebar-collapsed-w; }\r\n\r\n.sidebar-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 20px 16px;\r\n  cursor: pointer;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\r\n  flex-shrink: 0;\r\n\r\n  .brand-logo {\r\n    width: 36px;\r\n    height: 36px;\r\n    object-fit: contain;\r\n    flex-shrink: 0;\r\n  }\r\n\r\n  .brand-text {\r\n    display: flex;\r\n    flex-direction: column;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .brand-name {\r\n    font-size: 15px;\r\n    font-weight: 600;\r\n    color: #fff;\r\n    white-space: nowrap;\r\n    letter-spacing: 0.5px;\r\n  }\r\n\r\n  .brand-sub {\r\n    font-size: 11px;\r\n    color: @gold;\r\n    margin-top: 2px;\r\n    letter-spacing: 1px;\r\n    text-transform: uppercase;\r\n  }\r\n}\r\n\r\n.sidebar-scroll {\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar-footer {\r\n  padding: 14px 16px;\r\n  font-size: 11px;\r\n  color: rgba(255, 255, 255, 0.3);\r\n  text-align: center;\r\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.main-area {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  transition: margin-left 0.28s cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n.sidebar-expanded .main-area {\r\n  margin-left: @sidebar-w;\r\n}\r\n\r\n.sidebar-collapsed .main-area {\r\n  margin-left: @sidebar-collapsed-w;\r\n}\r\n\r\n.topbar {\r\n  height: 60px;\r\n  background: #fff;\r\n  border-bottom: 1px solid #ebeef3;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 24px;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 100;\r\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);\r\n}\r\n\r\n.topbar-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n\r\n.collapse-btn {\r\n  width: 36px;\r\n  height: 36px;\r\n  border: 1px solid #e8eaef;\r\n  border-radius: 8px;\r\n  background: #fff;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #606266;\r\n  transition: all 0.2s;\r\n  font-size: 18px;\r\n\r\n  &:hover {\r\n    border-color: @gold;\r\n    color: @gold;\r\n    background: rgba(201, 169, 98, 0.06);\r\n  }\r\n}\r\n\r\n.breadcrumb {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 14px;\r\n  color: #909399;\r\n\r\n  .breadcrumb-current {\r\n    color: #303133;\r\n    font-weight: 600;\r\n  }\r\n\r\n  i { font-size: 12px; }\r\n}\r\n\r\n.user-block {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  cursor: pointer;\r\n  padding: 6px 12px;\r\n  border-radius: 8px;\r\n  transition: background 0.2s;\r\n\r\n  &:hover { background: #f5f6f8; }\r\n\r\n  .user-avatar {\r\n    width: 32px;\r\n    height: 32px;\r\n    border-radius: 50%;\r\n    background: linear-gradient(135deg, @gold, #a88b4a);\r\n    color: #fff;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n  }\r\n\r\n  .user-name {\r\n    font-size: 14px;\r\n    color: #303133;\r\n    font-weight: 500;\r\n  }\r\n\r\n  i { color: #c0c4cc; font-size: 12px; }\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  padding: 20px 24px 32px;\r\n}\r\n\r\n/* ========== 侧边栏菜单深度样式 ========== */\r\n/deep/ .sidebar-menu {\r\n  border-right: none !important;\r\n  padding: 8px 0;\r\n\r\n  .el-menu-item,\r\n  .el-submenu__title {\r\n    height: 46px !important;\r\n    line-height: 46px !important;\r\n    margin: 2px 10px;\r\n    border-radius: 8px;\r\n    transition: all 0.2s;\r\n\r\n    i { color: rgba(255, 255, 255, 0.55); margin-right: 8px; }\r\n    &:hover {\r\n      background: rgba(255, 255, 255, 0.06) !important;\r\n      i { color: @gold-light; }\r\n    }\r\n  }\r\n\r\n  .el-menu-item.is-active {\r\n    background: linear-gradient(90deg, rgba(201, 169, 98, 0.22), rgba(201, 169, 98, 0.06)) !important;\r\n    color: @gold-light !important;\r\n    font-weight: 500;\r\n    position: relative;\r\n\r\n    &::before {\r\n      content: \"\";\r\n      position: absolute;\r\n      left: 0;\r\n      top: 10px;\r\n      bottom: 10px;\r\n      width: 3px;\r\n      background: @gold;\r\n      border-radius: 0 2px 2px 0;\r\n    }\r\n\r\n    i { color: @gold-light !important; }\r\n  }\r\n\r\n  .el-submenu.is-active > .el-submenu__title {\r\n    color: @gold-light !important;\r\n    i { color: @gold-light !important; }\r\n  }\r\n\r\n  .el-submenu .el-menu-item {\r\n    min-width: auto;\r\n    padding-left: 48px !important;\r\n    height: 42px !important;\r\n    line-height: 42px !important;\r\n  }\r\n\r\n  &.el-menu--collapse {\r\n    .el-menu-item,\r\n    .el-submenu__title {\r\n      margin: 2px 8px;\r\n      padding: 0 !important;\r\n      text-align: center;\r\n    }\r\n  }\r\n}\r\n\r\n/deep/ .sidebar-scroll .el-scrollbar__wrap {\r\n  overflow-x: hidden;\r\n}\r\n</style>\r\n"],"mappings":";AAkIA,SAAAA,QAAA,EAAAC,YAAA;AACA,SAAAC,WAAA;AAEA,MAAAC,SAAA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;AACA;AAEA;EACAC,IAAA;EACAC,QAAA;IACA,GAAAL,QAAA;IACAM,WAAA;MACA,YAAAC,MAAA,CAAAC,IAAA;IACA;IACAC,UAAA;MACA,OAAAN,SAAA,MAAAI,MAAA,CAAAC,IAAA;IACA;IACAE,WAAA;MACA,MAAAN,IAAA,QAAAO,IAAA,EAAAP,IAAA;MACA,OAAAA,IAAA,CAAAQ,MAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC,UAAA;IACA;EACA;EACAC,OAAA;IACA,GAAAd,YAAA;IACAe,cAAAC,GAAA;MACA,IAAAA,GAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,WAAAF,GAAA;QACA,KAAAG,MAAA;MACA;IACA;IACAA,OAAA;MACA,KAAAC,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;MACA,GAAAC,IAAA;QACAvB,WAAA;QACA,KAAAwB,OAAA;QACA,KAAAC,QAAA;QACA,KAAAT,OAAA,CAAAU,OAAA;MACA,GAAAC,KAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}