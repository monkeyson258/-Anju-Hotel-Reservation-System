{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { findAllCategoryAPI } from '@/api/category';\nimport { findRoomListAPI } from '@/api/room';\nimport { addOrdersAPI } from '@/api/orders';\nimport dayjs from 'dayjs';\nexport default {\n  name: 'FrontCategory',\n  data() {\n    return {\n      pickerOptions: {\n        disabledDate: this.disabledDate\n      },\n      formInline: {\n        startDate: dayjs().format('YYYY-MM-DD'),\n        categoryId: null,\n        canUse: null\n      },\n      categoryList: [],\n      roomList: [],\n      form: {\n        gender: 1,\n        categoryName: '',\n        days: 1\n      },\n      dialogVisible: false,\n      genderOptions: [{\n        label: '男',\n        value: 1\n      }, {\n        label: '女',\n        value: 2\n      }]\n    };\n  },\n  async mounted() {\n    if (this.$route.query?.categoryId) {\n      this.formInline.categoryId = parseInt(this.$route.query?.categoryId);\n    }\n    this.getCategoryList();\n    this.getList();\n  },\n  methods: {\n    handleClose() {\n      this.dialogVisible = false;\n      this.form = {\n        gender: 1,\n        categoryName: '',\n        days: 1\n      };\n    },\n    disabledDate(time) {\n      //禁用今天之前的日期\n      return dayjs(time).isBefore(dayjs(), 'day');\n    },\n    async getCategoryList() {\n      const {\n        data\n      } = await findAllCategoryAPI();\n      this.categoryList = data;\n    },\n    async getList() {\n      const {\n        data\n      } = await findRoomListAPI(this.formInline);\n      this.roomList = data;\n    },\n    onSubmit() {\n      this.getList();\n    },\n    //点击入住按钮\n    handleAdd({\n      category,\n      roomNum,\n      id\n    }) {\n      this.form.money = category.price;\n      this.form.roomId = id;\n      this.form.roomNum = roomNum;\n      this.form.categoryName = category.categoryName;\n      this.dialogVisible = true;\n    },\n    //点击弹框中的确认\n    async handleConfirm() {\n      if (this.form.days == null || this.form.days == \"\") {\n        this.$message({\n          message: \"居住天数不能为空\",\n          type: \"error\"\n        });\n        return;\n      }\n      if (this.form.name == null || this.form.name == \"\") {\n        this.$message({\n          message: \"姓名不能为空\",\n          type: \"error\"\n        });\n        return;\n      }\n      if (form.phone == null || form.phone == \"\") {\n        this.$message({\n          message: \"电话不能为空\",\n          type: \"error\"\n        });\n        return;\n      }\n      if (this.form.idcard == null || this.form.idcard == \"\") {\n        this.$message({\n          message: \"身份证不能为空\",\n          type: \"error\"\n        });\n        return;\n      }\n      const res = await addOrdersAPI(this.form);\n      this.$message({\n        message: res.message,\n        type: res.flag ? \"success\" : \"error\"\n      });\n      if (res.flag) {\n        this.dialogVisible = false;\n        setTimeout(() => {\n          this.$router.push('/admin/orders');\n        }, 1000);\n      }\n    }\n  }\n};","map":{"version":3,"names":["findAllCategoryAPI","findRoomListAPI","addOrdersAPI","dayjs","name","data","pickerOptions","disabledDate","formInline","startDate","format","categoryId","canUse","categoryList","roomList","form","gender","categoryName","days","dialogVisible","genderOptions","label","value","mounted","$route","query","parseInt","getCategoryList","getList","methods","handleClose","time","isBefore","onSubmit","handleAdd","category","roomNum","id","money","price","roomId","handleConfirm","$message","message","type","phone","idcard","res","flag","setTimeout","$router","push"],"sources":["src/views/OrdersAdd.vue"],"sourcesContent":["<template>\r\n    <div class=\"page-container\">\r\n        <el-card>\r\n            <div class=\"section\">\r\n                <div slot=\"header\" class=\"clearfix\">\r\n                    <span>办理入住</span>\r\n                </div>\r\n                <el-form :inline=\"true\" :model=\"formInline\" class=\"mt-40\">\r\n                    <el-form-item label=\"入住日期\">\r\n                        <el-date-picker size=\"mini\" disabled :clearable=\"false\" :picker-options=\"pickerOptions\"\r\n                            v-model=\"formInline.startDate\" type=\"date\" placeholder=\"入住日期\" value-format=\"yyyy-MM-dd\"\r\n                            format=\"yyyy-MM-dd\">\r\n                        </el-date-picker>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"房型\">\r\n                        <el-select size=\"mini\" v-model=\"formInline.categoryId\" placeholder=\"房型\" clearable>\r\n                            <el-option v-for=\"item in categoryList\" :label=\"item.categoryName\" :value=\"item.id\"\r\n                                :key=\"item.id\"></el-option>\r\n                        </el-select>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"状态\">\r\n                        <el-select size=\"mini\" v-model=\"formInline.canUse\" placeholder=\"状态\" clearable>\r\n                            <el-option label=\"可入住\" :value=\"true\"></el-option>\r\n                            <el-option label=\"已满房\" :value=\"false\"></el-option>\r\n                        </el-select>\r\n                    </el-form-item>\r\n                    <el-form-item>\r\n                        <el-button size=\"mini\" type=\"primary\" @click=\"onSubmit\">查询</el-button>\r\n                    </el-form-item>\r\n                </el-form>\r\n                <div class=\"section-list\">\r\n\r\n                    <div v-for=\"item in roomList\" :key=\"item.id\" class=\"section-item\">\r\n                        <img :src=\"$baseFileUrl + item.category.photo\" class=\"hotel-img\">\r\n                        <div class=\"hotel-title\">{{ item.category.categoryName }}-{{ item.roomNum }}</div>\r\n                        <div class=\"flex justify-between item-center w-full\">\r\n                            <el-tag size=\"mini\" type=\"success\" v-if=\"item.canUse\">可入住</el-tag>\r\n                            <el-tag size=\"mini\" type=\"danger\" v-else>已满房</el-tag>\r\n                            <div class=\"hotel-price\">￥{{ item.category.price }}</div>\r\n                        </div>\r\n                        <div class=\"text-right w-full\">\r\n                            <el-button v-if=\"item.canUse\" type=\"warning\" size=\"mini\" @click=\"handleAdd(item)\">入住</el-button>\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                    <!-- 多写两个标签解决flex最后一行对齐问题 -->\r\n                    <div class=\"section-item-empty\"></div>\r\n                    <div class=\"section-item-empty\"></div>\r\n                </div>\r\n            </div>\r\n        </el-card>\r\n\r\n        <el-dialog title=\"办理入住\" :visible.sync=\"dialogVisible\" width=\"500px\" :before-close=\"handleClose\">\r\n            <el-form ref=\"form\" :model=\"form\" label-width=\"80px\">\r\n                <el-row>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"房型\">\r\n                            <el-tag size=\"mini\" type=\"info\">{{ form.categoryName }}</el-tag>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"房号\">\r\n                            <el-tag size=\"mini\" type=\"info\">{{ form.roomNum }}</el-tag>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"入住时间\">\r\n                            <el-tag size=\"mini\" type=\"info\">今天</el-tag>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"居住天数\">\r\n                            <el-input type=\"number\" size=\"mini\" v-model=\"form.days\"></el-input>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"姓名\">\r\n                            <el-input size=\"mini\" v-model=\"form.name\"></el-input>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"性别\">\r\n                            <el-select size=\"mini\" v-model=\"form.gender\" placeholder=\"请选择\">\r\n                                <el-option v-for=\"item in genderOptions\" :key=\"item.value\" :label=\"item.label\"\r\n                                    :value=\"item.value\">\r\n                                </el-option>\r\n                            </el-select>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"电话\">\r\n                            <el-input size=\"mini\" v-model=\"form.phone\"></el-input>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"身份证\">\r\n                            <el-input size=\"mini\" v-model=\"form.idcard\"></el-input>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"已付金额\">\r\n                            <el-tag size=\"mini\" type=\"info\">{{ form.money }}</el-tag>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                </el-row>\r\n            </el-form>\r\n            <span slot=\"footer\" class=\"dialog-footer\">\r\n                <el-button size=\"mini\" type=\"primary\" @click=\"handleConfirm\">确 定</el-button>\r\n            </span>\r\n        </el-dialog>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport { findAllCategoryAPI } from '@/api/category'\r\nimport { findRoomListAPI } from '@/api/room'\r\nimport { addOrdersAPI } from '@/api/orders'\r\nimport dayjs from 'dayjs'\r\nexport default {\r\n    name: 'FrontCategory',\r\n\r\n    data() {\r\n        return {\r\n            pickerOptions: {\r\n                disabledDate: this.disabledDate\r\n            },\r\n            formInline: {\r\n                startDate: dayjs().format('YYYY-MM-DD'),\r\n                categoryId: null,\r\n                canUse: null\r\n            },\r\n            categoryList: [],\r\n            roomList: [],\r\n            form: {\r\n                gender: 1,\r\n                categoryName: '',\r\n                days: 1\r\n            },\r\n            dialogVisible: false,\r\n            genderOptions: [\r\n                {\r\n                    label: '男',\r\n                    value: 1\r\n                },\r\n                {\r\n                    label: '女',\r\n                    value: 2\r\n                }\r\n            ],\r\n        };\r\n    },\r\n\r\n    async mounted() {\r\n        if (this.$route.query?.categoryId) {\r\n            this.formInline.categoryId = parseInt(this.$route.query?.categoryId)\r\n        }\r\n        this.getCategoryList()\r\n        this.getList()\r\n    },\r\n\r\n    methods: {\r\n        handleClose() {\r\n            this.dialogVisible = false\r\n            this.form = {\r\n                gender: 1,\r\n                categoryName: '',\r\n                days: 1\r\n            }\r\n        },\r\n        disabledDate(time) {\r\n            //禁用今天之前的日期\r\n            return dayjs(time).isBefore(dayjs(), 'day')\r\n        },\r\n        async getCategoryList() {\r\n            const { data } = await findAllCategoryAPI()\r\n            this.categoryList = data\r\n        },\r\n        async getList() {\r\n            const { data } = await findRoomListAPI(this.formInline)\r\n            this.roomList = data;\r\n        },\r\n        onSubmit() {\r\n            this.getList()\r\n        },\r\n        //点击入住按钮\r\n        handleAdd({ category, roomNum, id }) {\r\n            this.form.money = category.price\r\n            this.form.roomId = id\r\n            this.form.roomNum = roomNum\r\n            this.form.categoryName = category.categoryName\r\n            this.dialogVisible = true\r\n        },\r\n        //点击弹框中的确认\r\n        async handleConfirm() {\r\n            if(this.form.days == null || this.form.days == \"\"){\r\n                this.$message({\r\n                    message: \"居住天数不能为空\",\r\n                    type: \"error\",\r\n                });\r\n                return\r\n            }\r\n            if(this.form.name == null || this.form.name == \"\"){\r\n                this.$message({\r\n                    message: \"姓名不能为空\",\r\n                    type: \"error\",\r\n                });\r\n                return\r\n            }\r\n            if(form.phone == null || form.phone == \"\"){\r\n                this.$message({\r\n                    message: \"电话不能为空\",\r\n                    type: \"error\",\r\n                });\r\n                return\r\n            }\r\n            if(this.form.idcard == null || this.form.idcard == \"\"){\r\n                this.$message({\r\n                    message: \"身份证不能为空\",\r\n                    type: \"error\",\r\n                });\r\n                return\r\n            }\r\n            const res = await addOrdersAPI(this.form)\r\n            this.$message({\r\n                message: res.message,\r\n                type: res.flag ? \"success\" : \"error\",\r\n            });\r\n            if (res.flag) {\r\n                this.dialogVisible = false\r\n                setTimeout(() => {\r\n                    this.$router.push('/admin/orders')\r\n                }, 1000);\r\n            }\r\n        }\r\n    },\r\n};\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.page-container {\r\n    margin: 20px auto;\r\n\r\n    .section {\r\n        .section-title {\r\n            background-color: #303643;\r\n            color: #fff;\r\n            padding: 16px;\r\n            border-radius: 6px;\r\n            text-align: center;\r\n        }\r\n\r\n        .section-list {\r\n            margin-bottom: 20px;\r\n            display: flex;\r\n            flex-wrap: wrap;\r\n            justify-content: space-between;\r\n\r\n            // //重要 解决最后一行两端对齐的问题\r\n            &::after {\r\n                content: '';\r\n                // flex: 1;\r\n                width: 290px;\r\n            }\r\n\r\n            .section-item-empty {\r\n                width: 290px;\r\n            }\r\n\r\n            .section-item {\r\n                // width: 290px;\r\n                width: 290px;\r\n                height: 320px;\r\n                padding: 16px;\r\n                box-sizing: border-box;\r\n                border-radius: 6px;\r\n                margin-bottom: 10px;\r\n                // background-color: antiquewhite;\r\n\r\n                border: 1px solid #DCDFE6;\r\n                display: flex;\r\n                flex-direction: column;\r\n                align-items: center;\r\n\r\n                // margin-left: 10px;\r\n                // 等差数列(n-1)*4+1：1 4 9 13 左边距0 每行的第一个元素\r\n                &:nth-child(4n-3) {\r\n                    // background-color: deepskyblue;\r\n                    margin-left: 0 !important;\r\n                }\r\n\r\n                .hotel-img {\r\n                    width: 100%;\r\n                    height: 180px;\r\n                }\r\n\r\n                .hotel-title {\r\n                    font-weight: bold;\r\n                    width: 100%;\r\n                    margin: 10px;\r\n                    text-overflow: ellipsis;\r\n                    overflow: hidden;\r\n                    white-space: nowrap;\r\n                }\r\n\r\n                .hotel-price {\r\n                    color: red;\r\n                    width: 100%;\r\n                    margin: 4px;\r\n                    text-align: right;\r\n                }\r\n\r\n            }\r\n        }\r\n    }\r\n}\r\n</style>"],"mappings":";AAmHA,SAAAA,kBAAA;AACA,SAAAC,eAAA;AACA,SAAAC,YAAA;AACA,OAAAC,KAAA;AACA;EACAC,IAAA;EAEAC,KAAA;IACA;MACAC,aAAA;QACAC,YAAA,OAAAA;MACA;MACAC,UAAA;QACAC,SAAA,EAAAN,KAAA,GAAAO,MAAA;QACAC,UAAA;QACAC,MAAA;MACA;MACAC,YAAA;MACAC,QAAA;MACAC,IAAA;QACAC,MAAA;QACAC,YAAA;QACAC,IAAA;MACA;MACAC,aAAA;MACAC,aAAA,GACA;QACAC,KAAA;QACAC,KAAA;MACA,GACA;QACAD,KAAA;QACAC,KAAA;MACA;IAEA;EACA;EAEA,MAAAC,QAAA;IACA,SAAAC,MAAA,CAAAC,KAAA,EAAAd,UAAA;MACA,KAAAH,UAAA,CAAAG,UAAA,GAAAe,QAAA,MAAAF,MAAA,CAAAC,KAAA,EAAAd,UAAA;IACA;IACA,KAAAgB,eAAA;IACA,KAAAC,OAAA;EACA;EAEAC,OAAA;IACAC,YAAA;MACA,KAAAX,aAAA;MACA,KAAAJ,IAAA;QACAC,MAAA;QACAC,YAAA;QACAC,IAAA;MACA;IACA;IACAX,aAAAwB,IAAA;MACA;MACA,OAAA5B,KAAA,CAAA4B,IAAA,EAAAC,QAAA,CAAA7B,KAAA;IACA;IACA,MAAAwB,gBAAA;MACA;QAAAtB;MAAA,UAAAL,kBAAA;MACA,KAAAa,YAAA,GAAAR,IAAA;IACA;IACA,MAAAuB,QAAA;MACA;QAAAvB;MAAA,UAAAJ,eAAA,MAAAO,UAAA;MACA,KAAAM,QAAA,GAAAT,IAAA;IACA;IACA4B,SAAA;MACA,KAAAL,OAAA;IACA;IACA;IACAM,UAAA;MAAAC,QAAA;MAAAC,OAAA;MAAAC;IAAA;MACA,KAAAtB,IAAA,CAAAuB,KAAA,GAAAH,QAAA,CAAAI,KAAA;MACA,KAAAxB,IAAA,CAAAyB,MAAA,GAAAH,EAAA;MACA,KAAAtB,IAAA,CAAAqB,OAAA,GAAAA,OAAA;MACA,KAAArB,IAAA,CAAAE,YAAA,GAAAkB,QAAA,CAAAlB,YAAA;MACA,KAAAE,aAAA;IACA;IACA;IACA,MAAAsB,cAAA;MACA,SAAA1B,IAAA,CAAAG,IAAA,iBAAAH,IAAA,CAAAG,IAAA;QACA,KAAAwB,QAAA;UACAC,OAAA;UACAC,IAAA;QACA;QACA;MACA;MACA,SAAA7B,IAAA,CAAAX,IAAA,iBAAAW,IAAA,CAAAX,IAAA;QACA,KAAAsC,QAAA;UACAC,OAAA;UACAC,IAAA;QACA;QACA;MACA;MACA,IAAA7B,IAAA,CAAA8B,KAAA,YAAA9B,IAAA,CAAA8B,KAAA;QACA,KAAAH,QAAA;UACAC,OAAA;UACAC,IAAA;QACA;QACA;MACA;MACA,SAAA7B,IAAA,CAAA+B,MAAA,iBAAA/B,IAAA,CAAA+B,MAAA;QACA,KAAAJ,QAAA;UACAC,OAAA;UACAC,IAAA;QACA;QACA;MACA;MACA,MAAAG,GAAA,SAAA7C,YAAA,MAAAa,IAAA;MACA,KAAA2B,QAAA;QACAC,OAAA,EAAAI,GAAA,CAAAJ,OAAA;QACAC,IAAA,EAAAG,GAAA,CAAAC,IAAA;MACA;MACA,IAAAD,GAAA,CAAAC,IAAA;QACA,KAAA7B,a