{"ast":null,"code":"import * as echarts from 'echarts';\nimport { mapState } from 'vuex';\nimport { getOverviewAPI, getCheckInTrendAPI, getIntelligenceAPI } from '@/api/stats';\nimport AiChat from '@/components/AiChat.vue';\nexport default {\n  name: 'Welcome',\n  components: {\n    AiChat\n  },\n  data() {\n    return {\n      overview: {},\n      topWarning: null,\n      chart: null\n    };\n  },\n  computed: {\n    ...mapState(['user'])\n  },\n  mounted() {\n    this.loadData();\n    window.addEventListener('resize', this.handleResize);\n  },\n  beforeDestroy() {\n    window.removeEventListener('resize', this.handleResize);\n    if (this.chart) this.chart.dispose();\n  },\n  methods: {\n    async loadData() {\n      try {\n        const [overview, trend, intel] = await Promise.all([getOverviewAPI(), getCheckInTrendAPI(7), getIntelligenceAPI()]);\n        this.overview = overview.data;\n        if (intel.data.warnings && intel.data.warnings.length) {\n          this.topWarning = intel.data.warnings[0];\n        }\n        this.$nextTick(() => this.renderChart(trend.data));\n      } catch (e) {/* handled by interceptor */}\n    },\n    renderChart(data) {\n      if (!this.$refs.miniChart) return;\n      this.chart = echarts.init(this.$refs.miniChart);\n      this.chart.setOption({\n        tooltip: {\n          trigger: 'axis'\n        },\n        grid: {\n          left: 40,\n          right: 16,\n          top: 16,\n          bottom: 24\n        },\n        xAxis: {\n          type: 'category',\n          data: data.dates,\n          axisLabel: {\n            fontSize: 11\n          }\n        },\n        yAxis: {\n          type: 'value',\n          minInterval: 1\n        },\n        series: [{\n          type: 'line',\n          smooth: true,\n          data: data.counts,\n          areaStyle: {\n            color: 'rgba(201,169,98,0.18)'\n          },\n          lineStyle: {\n            color: '#c9a962',\n            width: 2\n          },\n          itemStyle: {\n            color: '#c9a962'\n          }\n        }]\n      });\n    },\n    handleResize() {\n      if (this.chart) this.chart.resize();\n    }\n  }\n};","map":{"version":3,"names":["echarts","mapState","getOverviewAPI","getCheckInTrendAPI","getIntelligenceAPI","AiChat","name","components","data","overview","topWarning","chart","computed","mounted","loadData","window","addEventListener","handleResize","beforeDestroy","removeEventListener","dispose","methods","trend","intel","Promise","all","warnings","length","$nextTick","renderChart","e","$refs","miniChart","init","setOption","tooltip","trigger","grid","left","right","top","bottom","xAxis","type","dates","axisLabel","fontSize","yAxis","minInterval","series","smooth","counts","areaStyle","color","lineStyle","width","itemStyle","resize"],"sources":["src/views/Welcome.vue"],"sourcesContent":["<template>\r\n  <div class=\"welcome-page\">\r\n    <div class=\"welcome-banner\">\r\n      <div class=\"banner-text\">\r\n        <h1>欢迎回来，{{ user.name || '管理员' }}</h1>\r\n        <p>{{ $sysTitle }} · 数据驾驶舱</p>\r\n      </div>\r\n      <div class=\"banner-stats\" v-if=\"overview.totalRooms\">\r\n        <div class=\"mini-stat\">\r\n          <span class=\"val\">{{ overview.todayOccupancyRate }}%</span>\r\n          <span class=\"lbl\">今日入住率</span>\r\n        </div>\r\n        <div class=\"mini-stat\">\r\n          <span class=\"val\">{{ overview.availableRooms }}</span>\r\n          <span class=\"lbl\">可用房间</span>\r\n        </div>\r\n        <div class=\"mini-stat\">\r\n          <span class=\"val\">{{ overview.pendingAppointments }}</span>\r\n          <span class=\"lbl\">待处理预约</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <el-row :gutter=\"16\" class=\"quick-links\">\r\n      <el-col :span=\"8\">\r\n        <el-card shadow=\"hover\" class=\"link-card\" @click.native=\"$router.push('/admin/statistics')\">\r\n          <i class=\"el-icon-data-analysis link-icon\" style=\"color:#c9a962\"></i>\r\n          <h3>数据统计</h3>\r\n          <p>入住趋势、房型占比、营收分析</p>\r\n        </el-card>\r\n      </el-col>\r\n      <el-col :span=\"8\">\r\n        <el-card shadow=\"hover\" class=\"link-card\" @click.native=\"$router.push('/admin/intelligence')\">\r\n          <i class=\"el-icon-cpu link-icon\" style=\"color:#67c23a\"></i>\r\n          <h3>数智决策</h3>\r\n          <p>入住率预警、房型销量智能建议</p>\r\n        </el-card>\r\n      </el-col>\r\n      <el-col :span=\"8\">\r\n        <el-card shadow=\"hover\" class=\"link-card\" @click.native=\"$router.push('/admin/orders')\">\r\n          <i class=\"el-icon-s-order link-icon\" style=\"color:#e6a23c\"></i>\r\n          <h3>入住管理</h3>\r\n          <p>处理入住、退房等日常运营</p>\r\n        </el-card>\r\n      </el-col>\r\n    </el-row>\r\n\r\n    <el-row :gutter=\"16\">\r\n      <el-col :span=\"16\">\r\n        <el-card shadow=\"hover\">\r\n          <div slot=\"header\"><i class=\"el-icon-data-line\"></i> 近七天入住趋势预览</div>\r\n          <div ref=\"miniChart\" class=\"mini-chart\"></div>\r\n        </el-card>\r\n      </el-col>\r\n      <el-col :span=\"8\">\r\n        <el-card shadow=\"hover\" class=\"alert-card\">\r\n          <div slot=\"header\"><i class=\"el-icon-warning-outline\"></i> 智能预警</div>\r\n          <div v-if=\"topWarning\" class=\"alert-content\">\r\n            <el-tag :type=\"topWarning.level === 'danger' ? 'danger' : topWarning.level\" size=\"small\">\r\n              {{ topWarning.title }}\r\n            </el-tag>\r\n            <p>{{ topWarning.message }}</p>\r\n          </div>\r\n          <el-empty v-else description=\"加载中...\" :image-size=\"60\"></el-empty>\r\n          <el-button type=\"text\" @click=\"$router.push('/admin/intelligence')\">查看详细分析 →</el-button>\r\n        </el-card>\r\n      </el-col>\r\n    </el-row>\r\n\r\n    <AiChat greeting=\"您好！我是斌安居酒店管理助手，可以帮您分析运营数据、解答管理问题。\" />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport * as echarts from 'echarts'\r\nimport { mapState } from 'vuex'\r\nimport { getOverviewAPI, getCheckInTrendAPI, getIntelligenceAPI } from '@/api/stats'\r\nimport AiChat from '@/components/AiChat.vue'\r\n\r\nexport default {\r\n  name: 'Welcome',\r\n  components: { AiChat },\r\n  data() {\r\n    return {\r\n      overview: {},\r\n      topWarning: null,\r\n      chart: null\r\n    }\r\n  },\r\n  computed: {\r\n    ...mapState(['user'])\r\n  },\r\n  mounted() {\r\n    this.loadData()\r\n    window.addEventListener('resize', this.handleResize)\r\n  },\r\n  beforeDestroy() {\r\n    window.removeEventListener('resize', this.handleResize)\r\n    if (this.chart) this.chart.dispose()\r\n  },\r\n  methods: {\r\n    async loadData() {\r\n      try {\r\n        const [overview, trend, intel] = await Promise.all([\r\n          getOverviewAPI(), getCheckInTrendAPI(7), getIntelligenceAPI()\r\n        ])\r\n        this.overview = overview.data\r\n        if (intel.data.warnings && intel.data.warnings.length) {\r\n          this.topWarning = intel.data.warnings[0]\r\n        }\r\n        this.$nextTick(() => this.renderChart(trend.data))\r\n      } catch (e) { /* handled by interceptor */ }\r\n    },\r\n    renderChart(data) {\r\n      if (!this.$refs.miniChart) return\r\n      this.chart = echarts.init(this.$refs.miniChart)\r\n      this.chart.setOption({\r\n        tooltip: { trigger: 'axis' },\r\n        grid: { left: 40, right: 16, top: 16, bottom: 24 },\r\n        xAxis: { type: 'category', data: data.dates, axisLabel: { fontSize: 11 } },\r\n        yAxis: { type: 'value', minInterval: 1 },\r\n        series: [{\r\n          type: 'line', smooth: true, data: data.counts,\r\n          areaStyle: { color: 'rgba(201,169,98,0.18)' },\r\n          lineStyle: { color: '#c9a962', width: 2 },\r\n          itemStyle: { color: '#c9a962' }\r\n        }]\r\n      })\r\n    },\r\n    handleResize() {\r\n      if (this.chart) this.chart.resize()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.welcome-page { padding: 0; }\r\n\r\n.welcome-banner {\r\n  background: linear-gradient(135deg, #141820 0%, #1c2333 60%, #2a3142 100%);\r\n  border-radius: 14px;\r\n  padding: 36px 40px;\r\n  color: #fff;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 20px;\r\n  border: 1px solid rgba(201, 169, 98, 0.15);\r\n  box-shadow: 0 8px 32px rgba(20, 24, 32, 0.12);\r\n\r\n  h1 { font-size: 26px; margin: 0 0 8px; font-weight: 600; }\r\n  p { margin: 0; color: #c9a962; font-size: 14px; letter-spacing: 1px; }\r\n}\r\n\r\n.banner-stats {\r\n  display: flex;\r\n  gap: 32px;\r\n\r\n  .mini-stat {\r\n    text-align: center;\r\n    .val { display: block; font-size: 28px; font-weight: 700; }\r\n    .lbl { font-size: 12px; opacity: 0.8; }\r\n  }\r\n}\r\n\r\n.quick-links { margin-bottom: 16px; }\r\n\r\n.link-card {\r\n  text-align: center;\r\n  cursor: pointer;\r\n  border-radius: 12px;\r\n  border: none;\r\n  transition: transform 0.25s, box-shadow 0.25s;\r\n  &:hover {\r\n    transform: translateY(-4px);\r\n    box-shadow: 0 8px 24px rgba(0,0,0,0.1);\r\n  }\r\n\r\n  .link-icon { font-size: 36px; margin-bottom: 8px; }\r\n  h3 { margin: 0 0 6px; font-size: 16px; color: #303133; }\r\n  p { margin: 0; font-size: 13px; color: #909399; }\r\n}\r\n\r\n.mini-chart { height: 240px; }\r\n\r\n.alert-card {\r\n  height: 100%;\r\n  .alert-content {\r\n    p { font-size: 13px; color: #606266; line-height: 1.6; margin: 12px 0; }\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AA0EA,YAAAA,OAAA;AACA,SAAAC,QAAA;AACA,SAAAC,cAAA,EAAAC,kBAAA,EAAAC,kBAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF;EAAA;EACAG,KAAA;IACA;MACAC,QAAA;MACAC,UAAA;MACAC,KAAA;IACA;EACA;EACAC,QAAA;IACA,GAAAX,QAAA;EACA;EACAY,QAAA;IACA,KAAAC,QAAA;IACAC,MAAA,CAAAC,gBAAA,gBAAAC,YAAA;EACA;EACAC,cAAA;IACAH,MAAA,CAAAI,mBAAA,gBAAAF,YAAA;IACA,SAAAN,KAAA,OAAAA,KAAA,CAAAS,OAAA;EACA;EACAC,OAAA;IACA,MAAAP,SAAA;MACA;QACA,OAAAL,QAAA,EAAAa,KAAA,EAAAC,KAAA,UAAAC,OAAA,CAAAC,GAAA,EACAvB,cAAA,IAAAC,kBAAA,KAAAC,kBAAA,GACA;QACA,KAAAK,QAAA,GAAAA,QAAA,CAAAD,IAAA;QACA,IAAAe,KAAA,CAAAf,IAAA,CAAAkB,QAAA,IAAAH,KAAA,CAAAf,IAAA,CAAAkB,QAAA,CAAAC,MAAA;UACA,KAAAjB,UAAA,GAAAa,KAAA,CAAAf,IAAA,CAAAkB,QAAA;QACA;QACA,KAAAE,SAAA,YAAAC,WAAA,CAAAP,KAAA,CAAAd,IAAA;MACA,SAAAsB,CAAA;IACA;IACAD,YAAArB,IAAA;MACA,UAAAuB,KAAA,CAAAC,SAAA;MACA,KAAArB,KAAA,GAAAX,OAAA,CAAAiC,IAAA,MAAAF,KAAA,CAAAC,SAAA;MACA,KAAArB,KAAA,CAAAuB,SAAA;QACAC,OAAA;UAAAC,OAAA;QAAA;QACAC,IAAA;UAAAC,IAAA;UAAAC,KAAA;UAAAC,GAAA;UAAAC,MAAA;QAAA;QACAC,KAAA;UAAAC,IAAA;UAAAnC,IAAA,EAAAA,IAAA,CAAAoC,KAAA;UAAAC,SAAA;YAAAC,QAAA;UAAA;QAAA;QACAC,KAAA;UAAAJ,IAAA;UAAAK,WAAA;QAAA;QACAC,MAAA;UACAN,IAAA;UAAAO,MAAA;UAAA1C,IAAA,EAAAA,IAAA,CAAA2C,MAAA;UACAC,SAAA;YAAAC,KAAA;UAAA;UACAC,SAAA;YAAAD,KAAA;YAAAE,KAAA;UAAA;UACAC,SAAA;YAAAH,KAAA;UAAA;QACA;MACA;IACA;IACApC,aAAA;MACA,SAAAN,KAAA,OAAAA,KAAA,CAAA8C,MAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}