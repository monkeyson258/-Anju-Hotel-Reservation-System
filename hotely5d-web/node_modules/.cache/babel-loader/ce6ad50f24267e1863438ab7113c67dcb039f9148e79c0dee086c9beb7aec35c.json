{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { registerAPI } from '@/api/system';\nimport request from '@/utils/request';\nexport default {\n  name: 'Register',\n  data() {\n    return {\n      form: {\n        gender: 1\n      },\n      genderOptions: [{\n        label: '男',\n        value: 1\n      }, {\n        label: '女',\n        value: 2\n      }],\n      fileList: []\n    };\n  },\n  methods: {\n    async submitForm() {\n      const res = await registerAPI(this.form);\n      this.$message({\n        message: res.message,\n        type: res.flag ? \"success\" : \"error\"\n      });\n      setTimeout(() => {\n        this.$router.push('/login');\n      }, 1000);\n    },\n    uploadHeadFile(item) {\n      let fileObj = item.file;\n      const form = new FormData(); // FormData 对象\n      form.append(\"photo\", fileObj); // 文件对象  'photo'是后台接收的参数名\n      request.post(\"/file/uploadPhoto\", form, \"form\").then(resp => {\n        // console.log(resp.data)\n        this.form.head = resp.data.filename;\n        this.fileList = [{\n          name: this.form.head,\n          url: this.$baseFileUrl + this.form.head\n        }];\n      });\n    }\n  }\n};","map":{"version":3,"names":["registerAPI","request","name","data","form","gender","genderOptions","label","value","fileList","methods","submitForm","res","$message","message","type","flag","setTimeout","$router","push","uploadHeadFile","item","fileObj","file","FormData","append","post","then","resp","head","filename","url","$baseFileUrl"],"sources":["src/views/front/Register.vue"],"sourcesContent":["<template>\r\n    <div class=\"container\">\r\n        <div class=\"login-box\">\r\n            <h2 class=\"title\" @click=\"$router.push('/front')\">{{ $sysTitle }}-注册</h2>\r\n            <el-form :model=\"form\" label-position=\"right\" label-width=\"80px\">\r\n                <el-form-item label=\"账号\">\r\n                    <el-input placeholder=\"请输入账号\" v-model=\"form.username\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"密码\">\r\n                    <el-input type=\"password\" placeholder=\"请输入密码\" v-model=\"form.password\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"姓名\">\r\n                    <el-input placeholder=\"请输入姓名\" v-model=\"form.name\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"性别\">\r\n                    <el-select v-model=\"form.gender\" placeholder=\"请选择\">\r\n                        <el-option v-for=\"item in genderOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\r\n                        </el-option>\r\n                    </el-select>\r\n                </el-form-item>\r\n                <el-form-item label=\"手机\">\r\n                    <el-input placeholder=\"请输入手机\" v-model=\"form.phone\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"身份证\">\r\n                    <el-input placeholder=\"请输入身份证\" v-model=\"form.idcard\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"头像\">\r\n                    <el-upload name=\"avatar\" class=\"upload-demo\" action=\"#\" :http-request=\"uploadHeadFile\"\r\n                        :file-list=\"fileList\" list-type=\"picture\">\r\n                        <el-button size=\"small\" type=\"primary\">点击上传</el-button>\r\n                    </el-upload>\r\n                </el-form-item>\r\n                <el-form-item>\r\n                    <el-button type=\"primary\" style=\"width: 400px;\" @click=\"submitForm\">注册</el-button>\r\n                    <div class=\"text-right\">\r\n                        已有账号?去<router-link to=\"/login\">登录</router-link>\r\n                    </div>\r\n                </el-form-item>\r\n            </el-form>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport { registerAPI } from '@/api/system'\r\nimport request from '@/utils/request'\r\nexport default {\r\n    name: 'Register',\r\n    data() {\r\n        return {\r\n            form: {\r\n                gender: 1\r\n            },\r\n            genderOptions: [\r\n                {\r\n                    label: '男',\r\n                    value: 1\r\n                },\r\n                {\r\n                    label: '女',\r\n                    value: 2\r\n                }\r\n            ],\r\n            fileList: []\r\n        }\r\n    },\r\n    methods: {\r\n        async submitForm() {\r\n            const res = await registerAPI(this.form)\r\n            this.$message({\r\n                message: res.message,\r\n                type: res.flag ? \"success\" : \"error\",\r\n            });\r\n            setTimeout(() => {\r\n                this.$router.push('/login')\r\n            }, 1000);\r\n        },\r\n        uploadHeadFile(item) {\r\n            let fileObj = item.file;\r\n            const form = new FormData(); // FormData 对象\r\n            form.append(\"photo\", fileObj); // 文件对象  'photo'是后台接收的参数名\r\n            request.post(\"/file/uploadPhoto\", form, \"form\").then((resp) => {\r\n                // console.log(resp.data)\r\n                this.form.head = resp.data.filename\r\n                this.fileList = [{\r\n                    name: this.form.head,\r\n                    url: this.$baseFileUrl + this.form.head\r\n                }]\r\n            })\r\n        },\r\n    }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.container {\r\n    width: 100vw;\r\n    height: 100vh;\r\n    background: #409eff;\r\n    background-size: cover;\r\n    display: flex;\r\n\r\n    .login-box {\r\n        padding: 10px;\r\n        border-radius: 10px;\r\n        min-width: 400px;\r\n        min-height: 200px;\r\n        background-color: aliceblue;\r\n        margin: auto;\r\n        padding-right: 40px;\r\n\r\n        .title {\r\n            text-align: center;\r\n            cursor: pointer;\r\n            &:hover{\r\n                color: #409eff;\r\n            }\r\n        }\r\n    }\r\n}\r\n</style>\r\n"],"mappings":";AA4CA,SAAAA,WAAA;AACA,OAAAC,OAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;QACAC,MAAA;MACA;MACAC,aAAA,GACA;QACAC,KAAA;QACAC,KAAA;MACA,GACA;QACAD,KAAA;QACAC,KAAA;MACA,EACA;MACAC,QAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,WAAA;MACA,MAAAC,GAAA,SAAAZ,WAAA,MAAAI,IAAA;MACA,KAAAS,QAAA;QACAC,OAAA,EAAAF,GAAA,CAAAE,OAAA;QACAC,IAAA,EAAAH,GAAA,CAAAI,IAAA;MACA;MACAC,UAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA;IACA;IACAC,eAAAC,IAAA;MACA,IAAAC,OAAA,GAAAD,IAAA,CAAAE,IAAA;MACA,MAAAnB,IAAA,OAAAoB,QAAA;MACApB,IAAA,CAAAqB,MAAA,UAAAH,OAAA;MACArB,OAAA,CAAAyB,IAAA,sBAAAtB,IAAA,UAAAuB,IAAA,CAAAC,IAAA;QACA;QACA,KAAAxB,IAAA,CAAAyB,IAAA,GAAAD,IAAA,CAAAzB,IAAA,CAAA2B,QAAA;QACA,KAAArB,QAAA;UACAP,IAAA,OAAAE,IAAA,CAAAyB,IAAA;UACAE,GAAA,OAAAC,YAAA,QAAA5B,IAAA,CAAAyB;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}