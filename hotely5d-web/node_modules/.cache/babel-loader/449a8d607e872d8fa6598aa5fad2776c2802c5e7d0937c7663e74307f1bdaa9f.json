{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { registerAPI } from '@/api/system';\nimport request from '@/utils/request';\nexport default {\n  name: 'Register',\n  data() {\n    return {\n      form: {\n        gender: 1\n      },\n      genderOptions: [{\n        label: '男',\n        value: 1\n      }, {\n        label: '女',\n        value: 2\n      }],\n      fileList: []\n    };\n  },\n  methods: {\n    async submitForm() {\n      const res = await registerAPI(this.form);\n      this.$message({\n        message: res.message,\n        type: res.flag ? \"success\" : \"error\"\n      });\n      setTimeout(() => {\n        this.$router.push('/login');\n      }, 1000);\n    },\n    uploadHeadFile(item) {\n      let fileObj = item.file;\n      const form = new FormData();\n      form.append(\"photo\", fileObj);\n      request.post(\"/file/uploadPhoto\", form, \"form\").then(resp => {\n        this.form.head = resp.data.filename;\n        this.fileList = [{\n          name: this.form.head,\n          url: this.$baseFileUrl + this.form.head\n        }];\n      });\n    }\n  }\n};","map":{"version":3,"names":["registerAPI","request","name","data","form","gender","genderOptions","label","value","fileList","methods","submitForm","res","$message","message","type","flag","setTimeout","$router","push","uploadHeadFile","item","fileObj","file","FormData","append","post","then","resp","head","filename","url","$baseFileUrl"],"sources":["src/views/front/Register.vue"],"sourcesContent":["<template>\r\n    <div class=\"auth-page\">\r\n        <div class=\"auth-bg\"></div>\r\n        <div class=\"auth-card auth-card-wide\">\r\n            <div class=\"auth-header\">\r\n                <img src=\"@/assets/logo.png\" class=\"auth-logo\" alt=\"logo\" />\r\n                <h2 class=\"title\" @click=\"$router.push('/front')\">{{ $sysTitle }}</h2>\r\n                <p class=\"subtitle\">创建账户 · 开启尊享之旅</p>\r\n            </div>\r\n            <el-form :model=\"form\" label-position=\"top\" class=\"auth-form\">\r\n                <el-row :gutter=\"16\">\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"账号\">\r\n                            <el-input placeholder=\"请输入账号\" v-model=\"form.username\" prefix-icon=\"el-icon-user\"></el-input>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"密码\">\r\n                            <el-input type=\"password\" placeholder=\"请输入密码\" v-model=\"form.password\" prefix-icon=\"el-icon-lock\" show-password></el-input>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"姓名\">\r\n                            <el-input placeholder=\"请输入姓名\" v-model=\"form.name\"></el-input>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"性别\">\r\n                            <el-select v-model=\"form.gender\" placeholder=\"请选择\" style=\"width:100%\">\r\n                                <el-option v-for=\"item in genderOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\"></el-option>\r\n                            </el-select>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"手机\">\r\n                            <el-input placeholder=\"请输入手机\" v-model=\"form.phone\"></el-input>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"12\">\r\n                        <el-form-item label=\"身份证\">\r\n                            <el-input placeholder=\"请输入身份证\" v-model=\"form.idcard\"></el-input>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                    <el-col :span=\"24\">\r\n                        <el-form-item label=\"头像\">\r\n                            <el-upload name=\"avatar\" class=\"upload-demo\" action=\"#\" :http-request=\"uploadHeadFile\"\r\n                                :file-list=\"fileList\" list-type=\"picture\">\r\n                                <el-button size=\"small\" type=\"primary\">点击上传</el-button>\r\n                            </el-upload>\r\n                        </el-form-item>\r\n                    </el-col>\r\n                </el-row>\r\n                <el-form-item>\r\n                    <el-button type=\"primary\" class=\"submit-btn\" @click=\"submitForm\">注 册</el-button>\r\n                    <div class=\"auth-footer\">\r\n                        已有账号？<router-link to=\"/login\">立即登录</router-link>\r\n                    </div>\r\n                </el-form-item>\r\n            </el-form>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport { registerAPI } from '@/api/system'\r\nimport request from '@/utils/request'\r\nexport default {\r\n    name: 'Register',\r\n    data() {\r\n        return {\r\n            form: { gender: 1 },\r\n            genderOptions: [\r\n                { label: '男', value: 1 },\r\n                { label: '女', value: 2 }\r\n            ],\r\n            fileList: []\r\n        }\r\n    },\r\n    methods: {\r\n        async submitForm() {\r\n            const res = await registerAPI(this.form)\r\n            this.$message({\r\n                message: res.message,\r\n                type: res.flag ? \"success\" : \"error\",\r\n            });\r\n            setTimeout(() => {\r\n                this.$router.push('/login')\r\n            }, 1000);\r\n        },\r\n        uploadHeadFile(item) {\r\n            let fileObj = item.file;\r\n            const form = new FormData();\r\n            form.append(\"photo\", fileObj);\r\n            request.post(\"/file/uploadPhoto\", form, \"form\").then((resp) => {\r\n                this.form.head = resp.data.filename\r\n                this.fileList = [{\r\n                    name: this.form.head,\r\n                    url: this.$baseFileUrl + this.form.head\r\n                }]\r\n            })\r\n        },\r\n    }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.auth-page {\r\n    width: 100vw;\r\n    min-height: 100vh;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    position: relative;\r\n    padding: 40px 24px;\r\n}\r\n\r\n.auth-bg {\r\n    position: fixed;\r\n    inset: 0;\r\n    background: linear-gradient(135deg, #141820 0%, #1c2333 40%, #2a3142 100%);\r\n    z-index: 0;\r\n\r\n    &::after {\r\n        content: \"\";\r\n        position: absolute;\r\n        inset: 0;\r\n        background: radial-gradient(ellipse at 70% 20%, rgba(201, 169, 98, 0.12) 0%, transparent 60%);\r\n    }\r\n}\r\n\r\n.auth-card {\r\n    position: relative;\r\n    z-index: 1;\r\n    width: 420px;\r\n    max-width: 100%;\r\n    padding: 36px 40px;\r\n    background: #fff;\r\n    border-radius: 16px;\r\n    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);\r\n}\r\n\r\n.auth-card-wide {\r\n    width: 560px;\r\n}\r\n\r\n.auth-header {\r\n    text-align: center;\r\n    margin-bottom: 24px;\r\n\r\n    .auth-logo { width: 44px; height: 44px; margin-bottom: 10px; }\r\n    .title {\r\n        font-size: 20px;\r\n        font-weight: 600;\r\n        color: #141820;\r\n        margin: 0 0 4px;\r\n        cursor: pointer;\r\n        &:hover { color: #c9a962; }\r\n    }\r\n    .subtitle { margin: 0; font-size: 13px; color: #909399; }\r\n}\r\n\r\n.auth-form /deep/ .el-form-item__label {\r\n    font-weight: 500;\r\n    color: #606266;\r\n    padding-bottom: 2px;\r\n}\r\n\r\n.submit-btn {\r\n    width: 100%;\r\n    height: 44px;\r\n    font-size: 15px;\r\n    letter-spacing: 4px;\r\n    border-radius: 8px;\r\n}\r\n\r\n.auth-footer {\r\n    text-align: center;\r\n    margin-top: 14px;\r\n    font-size: 13px;\r\n    color: #909399;\r\n}\r\n</style>\r\n"],"mappings":";AAgEA,SAAAA,WAAA;AACA,OAAAC,OAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;QAAAC,MAAA;MAAA;MACAC,aAAA,GACA;QAAAC,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,KAAA;QAAAC,KAAA;MAAA,EACA;MACAC,QAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAC,WAAA;MACA,MAAAC,GAAA,SAAAZ,WAAA,MAAAI,IAAA;MACA,KAAAS,QAAA;QACAC,OAAA,EAAAF,GAAA,CAAAE,OAAA;QACAC,IAAA,EAAAH,GAAA,CAAAI,IAAA;MACA;MACAC,UAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA;IACA;IACAC,eAAAC,IAAA;MACA,IAAAC,OAAA,GAAAD,IAAA,CAAAE,IAAA;MACA,MAAAnB,IAAA,OAAAoB,QAAA;MACApB,IAAA,CAAAqB,MAAA,UAAAH,OAAA;MACArB,OAAA,CAAAyB,IAAA,sBAAAtB,IAAA,UAAAuB,IAAA,CAAAC,IAAA;QACA,KAAAxB,IAAA,CAAAyB,IAAA,GAAAD,IAAA,CAAAzB,IAAA,CAAA2B,QAAA;QACA,KAAArB,QAAA;UACAP,IAAA,OAAAE,IAAA,CAAAyB,IAAA;UACAE,GAAA,OAAAC,YAAA,QAAA5B,IAAA,CAAAyB;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}