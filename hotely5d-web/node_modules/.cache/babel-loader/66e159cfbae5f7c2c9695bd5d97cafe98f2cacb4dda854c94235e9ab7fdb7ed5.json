{"ast":null,"code":"import { loginAPI, getUserInfoByTokenAPI } from '@/api/system';\nimport { mapMutations } from 'vuex';\nimport { setToken } from '@/utils/auth';\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      loginForm: {\n        role: 1,\n        username: '',\n        password: \"1\"\n      }\n    };\n  },\n  methods: {\n    ...mapMutations(['setUser', 'setRole', 'setToken']),\n    async login() {\n      const res = await loginAPI(this.loginForm);\n      this.$message({\n        type: res.flag ? 'success' : 'error',\n        message: res.message\n      });\n      if (res.flag) {\n        setToken(res.data);\n        this.setToken(res.data);\n        const result = await getUserInfoByTokenAPI();\n        this.setUser(result.data);\n        this.setRole(this.loginForm.role);\n        this.$router.replace(this.loginForm.role == 1 ? \"/admin\" : \"/front\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["loginAPI","getUserInfoByTokenAPI","mapMutations","setToken","name","data","loginForm","role","username","password","methods","login","res","$message","type","flag","message","result","setUser","setRole","$router","replace"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\r\n    <div class=\"auth-page\">\r\n        <div class=\"auth-bg\"></div>\r\n        <div class=\"auth-card\">\r\n            <div class=\"auth-header\">\r\n                <img src=\"@/assets/logo.png\" class=\"auth-logo\" alt=\"logo\" />\r\n                <h2 class=\"title\" @click=\"$router.push('/front')\">{{ $sysTitle }}</h2>\r\n                <p class=\"subtitle\">欢迎登录 · 尊享品质旅居</p>\r\n            </div>\r\n            <el-form :model=\"loginForm\" label-position=\"top\" class=\"auth-form\">\r\n                <el-form-item label=\"账号\">\r\n                    <el-input v-model=\"loginForm.username\" prefix-icon=\"el-icon-user\" placeholder=\"请输入账户\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"密码\">\r\n                    <el-input v-model=\"loginForm.password\" prefix-icon=\"el-icon-lock\" type=\"password\" placeholder=\"请输入密码\" show-password></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"登录身份\">\r\n                    <el-radio-group v-model=\"loginForm.role\" class=\"role-group\">\r\n                        <el-radio :label=\"1\">管理员</el-radio>\r\n                        <el-radio :label=\"2\">用户</el-radio>\r\n                    </el-radio-group>\r\n                </el-form-item>\r\n                <el-form-item>\r\n                    <el-button type=\"primary\" class=\"submit-btn\" @click=\"login\">登 录</el-button>\r\n                    <div class=\"auth-footer\">\r\n                        没有账号？<router-link to=\"/register\">立即注册</router-link>\r\n                    </div>\r\n                </el-form-item>\r\n            </el-form>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport { loginAPI, getUserInfoByTokenAPI } from '@/api/system'\r\nimport { mapMutations } from 'vuex'\r\nimport { setToken } from '@/utils/auth'\r\nexport default {\r\n    name: 'Login',\r\n    data() {\r\n        return {\r\n            loginForm: {\r\n                role: 1,\r\n                username: '',\r\n                password: \"1\"\r\n            }\r\n        }\r\n    },\r\n    methods: {\r\n        ...mapMutations(['setUser','setRole','setToken']),\r\n        async login() {\r\n            const res = await loginAPI(this.loginForm)\r\n            this.$message({\r\n                type: res.flag ? 'success' : 'error',\r\n                message: res.message\r\n            })\r\n            if (res.flag) {\r\n                setToken(res.data)\r\n                this.setToken(res.data)\r\n                const result = await getUserInfoByTokenAPI()\r\n                this.setUser(result.data)\r\n                this.setRole(this.loginForm.role)\r\n                this.$router.replace(this.loginForm.role == 1?\"/admin\":\"/front\")\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.auth-page {\r\n    width: 100vw;\r\n    min-height: 100vh;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    position: relative;\r\n    overflow: hidden;\r\n}\r\n\r\n.auth-bg {\r\n    position: absolute;\r\n    inset: 0;\r\n    background: linear-gradient(135deg, #141820 0%, #1c2333 40%, #2a3142 100%);\r\n\r\n    &::after {\r\n        content: \"\";\r\n        position: absolute;\r\n        inset: 0;\r\n        background: radial-gradient(ellipse at 70% 20%, rgba(201, 169, 98, 0.12) 0%, transparent 60%),\r\n                    radial-gradient(ellipse at 20% 80%, rgba(201, 169, 98, 0.08) 0%, transparent 50%);\r\n    }\r\n}\r\n\r\n.auth-card {\r\n    position: relative;\r\n    z-index: 1;\r\n    width: 420px;\r\n    max-width: calc(100vw - 48px);\r\n    padding: 40px 44px;\r\n    background: #fff;\r\n    border-radius: 16px;\r\n    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);\r\n}\r\n\r\n.auth-header {\r\n    text-align: center;\r\n    margin-bottom: 32px;\r\n\r\n    .auth-logo {\r\n        width: 48px;\r\n        height: 48px;\r\n        margin-bottom: 12px;\r\n    }\r\n\r\n    .title {\r\n        font-size: 22px;\r\n        font-weight: 600;\r\n        color: #141820;\r\n        margin: 0 0 6px;\r\n        cursor: pointer;\r\n        transition: color 0.2s;\r\n        &:hover { color: #c9a962; }\r\n    }\r\n\r\n    .subtitle {\r\n        margin: 0;\r\n        font-size: 13px;\r\n        color: #909399;\r\n        letter-spacing: 1px;\r\n    }\r\n}\r\n\r\n.auth-form {\r\n    /deep/ .el-form-item__label {\r\n        font-weight: 500;\r\n        color: #606266;\r\n        padding-bottom: 4px;\r\n    }\r\n}\r\n\r\n.role-group {\r\n    width: 100%;\r\n}\r\n\r\n.submit-btn {\r\n    width: 100%;\r\n    height: 44px;\r\n    font-size: 15px;\r\n    letter-spacing: 4px;\r\n    border-radius: 8px;\r\n}\r\n\r\n.auth-footer {\r\n    text-align: center;\r\n    margin-top: 16px;\r\n    font-size: 13px;\r\n    color: #909399;\r\n}\r\n</style>\r\n"],"mappings":"AAkCA,SAAAA,QAAA,EAAAC,qBAAA;AACA,SAAAC,YAAA;AACA,SAAAC,QAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;QACAC,IAAA;QACAC,QAAA;QACAC,QAAA;MACA;IACA;EACA;EACAC,OAAA;IACA,GAAAR,YAAA;IACA,MAAAS,MAAA;MACA,MAAAC,GAAA,SAAAZ,QAAA,MAAAM,SAAA;MACA,KAAAO,QAAA;QACAC,IAAA,EAAAF,GAAA,CAAAG,IAAA;QACAC,OAAA,EAAAJ,GAAA,CAAAI;MACA;MACA,IAAAJ,GAAA,CAAAG,IAAA;QACAZ,QAAA,CAAAS,GAAA,CAAAP,IAAA;QACA,KAAAF,QAAA,CAAAS,GAAA,CAAAP,IAAA;QACA,MAAAY,MAAA,SAAAhB,qBAAA;QACA,KAAAiB,OAAA,CAAAD,MAAA,CAAAZ,IAAA;QACA,KAAAc,OAAA,MAAAb,SAAA,CAAAC,IAAA;QACA,KAAAa,OAAA,CAAAC,OAAA,MAAAf,SAAA,CAAAC,IAAA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}