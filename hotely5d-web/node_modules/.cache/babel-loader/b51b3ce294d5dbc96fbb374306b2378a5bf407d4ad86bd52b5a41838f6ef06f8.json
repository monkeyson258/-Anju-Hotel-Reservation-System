{"ast":null,"code":"import request from '@/utils/request';\nimport { modifyMemberAPI } from \"@/api/member\";\nimport { mapMutations } from 'vuex';\nimport { getUserInfoByTokenAPI } from '@/api/system';\nexport default {\n  name: 'Hotely5dWebMemberInfo',\n  data() {\n    return {\n      genderOptions: [{\n        label: '男',\n        value: 1\n      }, {\n        label: '女',\n        value: 2\n      }],\n      form: {},\n      fileList: []\n    };\n  },\n  async mounted() {\n    //请求用户信息\n    const result = await getUserInfoByTokenAPI();\n    this.form = result.data;\n    this.fileList = [{\n      name: this.form.head,\n      url: this.$baseFileUrl + this.form.head\n    }];\n  },\n  methods: {\n    ...mapMutations(['setUser']),\n    async handleModify() {\n      const res = await modifyMemberAPI(this.form);\n      this.$message({\n        message: res.message,\n        type: res.flag ? \"success\" : \"error\"\n      });\n      if (res.flag) {\n        this.setUser(this.form);\n        setTimeout(() => {\n          this.$router.go(0);\n        }, 1000);\n      }\n    },\n    uploadHeadFile(item) {\n      let fileObj = item.file;\n      const form = new FormData(); // FormData 对象\n      form.append(\"photo\", fileObj); // 文件对象  'photo'是后台接收的参数名\n      request.post(\"/file/uploadPhoto\", form, \"form\").then(resp => {\n        // console.log(resp.data)\n        this.form.head = resp.data.filename;\n        this.fileList = [{\n          name: this.form.head,\n          url: this.$baseFileUrl + this.form.head\n        }];\n      });\n    }\n  }\n};","map":{"version":3,"names":["request","modifyMemberAPI","mapMutations","getUserInfoByTokenAPI","name","data","genderOptions","label","value","form","fileList","mounted","result","head","url","$baseFileUrl","methods","handleModify","res","$message","message","type","flag","setUser","setTimeout","$router","go","uploadHeadFile","item","fileObj","file","FormData","append","post","then","resp","filename"],"sources":["src/views/front/UserInfo.vue"],"sourcesContent":["<template>\r\n    <div class=\"page-container\">\r\n        <el-card class=\"box-card\">\r\n            <div slot=\"header\" class=\"clearfix\">\r\n                <span>个人信息</span>\r\n            </div>\r\n            <el-form label-position=\"left\" :model=\"form\" label-width=\"80px\">\r\n                <el-form-item label=\"账号\">\r\n                    <el-input disabled placeholder=\"请输入账号\" v-model=\"form.username\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"密码\">\r\n                    <el-input type=\"password\" placeholder=\"请输入密码\" v-model=\"form.password\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"姓名\">\r\n                    <el-input placeholder=\"请输入姓名\" v-model=\"form.name\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"性别\">\r\n                    <el-select v-model=\"form.gender\" placeholder=\"请选择\">\r\n                        <el-option v-for=\"item in genderOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\r\n                        </el-option>\r\n                    </el-select>\r\n                </el-form-item>\r\n                <el-form-item label=\"手机\">\r\n                    <el-input placeholder=\"请输入手机\" v-model=\"form.phone\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"身份证\">\r\n                    <el-input placeholder=\"请输入身份证\" v-model=\"form.idcard\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"头像\">\r\n                    <el-upload name=\"avatar\" class=\"upload-demo\" action=\"#\" :http-request=\"uploadHeadFile\"\r\n                        :file-list=\"fileList\" list-type=\"picture\">\r\n                        <el-button size=\"small\" type=\"primary\">点击上传</el-button>\r\n                    </el-upload>\r\n                </el-form-item>\r\n                <el-form-item>\r\n                    <el-button type=\"primary\" @click=\"handleModify\">修改</el-button>\r\n                </el-form-item>\r\n            </el-form>\r\n        </el-card>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport request from '@/utils/request'\r\nimport { modifyMemberAPI } from \"@/api/member\";\r\nimport { mapMutations } from 'vuex'\r\nimport { getUserInfoByTokenAPI } from '@/api/system'\r\nexport default {\r\n    name: 'Hotely5dWebMemberInfo',\r\n\r\n    data() {\r\n        return {\r\n            genderOptions: [\r\n                {\r\n                    label: '男',\r\n                    value: 1\r\n                },\r\n                {\r\n                    label: '女',\r\n                    value: 2\r\n                }\r\n            ],\r\n            form: {},\r\n            fileList: []\r\n        };\r\n    },\r\n\r\n    async mounted() {\r\n        //请求用户信息\r\n        const result = await getUserInfoByTokenAPI()\r\n        this.form = result.data\r\n        this.fileList = [{\r\n            name: this.form.head,\r\n            url: this.$baseFileUrl + this.form.head\r\n        }]\r\n    },\r\n\r\n    methods: {\r\n        ...mapMutations(['setUser']),\r\n        async handleModify() {\r\n            const res = await modifyMemberAPI(this.form);\r\n\r\n            this.$message({\r\n                message: res.message,\r\n                type: res.flag ? \"success\" : \"error\",\r\n            });\r\n            if (res.flag) {\r\n                this.setUser(this.form)\r\n                setTimeout(() => {\r\n                    this.$router.go(0)\r\n                }, 1000);\r\n            }\r\n\r\n        },\r\n        uploadHeadFile(item) {\r\n            let fileObj = item.file;\r\n            const form = new FormData(); // FormData 对象\r\n            form.append(\"photo\", fileObj); // 文件对象  'photo'是后台接收的参数名\r\n            request.post(\"/file/uploadPhoto\", form, \"form\").then((resp) => {\r\n                // console.log(resp.data)\r\n                this.form.head = resp.data.filename\r\n                this.fileList = [{\r\n                    name: this.form.head,\r\n                    url: this.$baseFileUrl + this.form.head\r\n                }]\r\n            })\r\n        },\r\n    },\r\n};\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.page-container {\r\n    width: 600px;\r\n    margin: 20px auto;\r\n}\r\n</style>"],"mappings":"AA2CA,OAAAA,OAAA;AACA,SAAAC,eAAA;AACA,SAAAC,YAAA;AACA,SAAAC,qBAAA;AACA;EACAC,IAAA;EAEAC,KAAA;IACA;MACAC,aAAA,GACA;QACAC,KAAA;QACAC,KAAA;MACA,GACA;QACAD,KAAA;QACAC,KAAA;MACA,EACA;MACAC,IAAA;MACAC,QAAA;IACA;EACA;EAEA,MAAAC,QAAA;IACA;IACA,MAAAC,MAAA,SAAAT,qBAAA;IACA,KAAAM,IAAA,GAAAG,MAAA,CAAAP,IAAA;IACA,KAAAK,QAAA;MACAN,IAAA,OAAAK,IAAA,CAAAI,IAAA;MACAC,GAAA,OAAAC,YAAA,QAAAN,IAAA,CAAAI;IACA;EACA;EAEAG,OAAA;IACA,GAAAd,YAAA;IACA,MAAAe,aAAA;MACA,MAAAC,GAAA,SAAAjB,eAAA,MAAAQ,IAAA;MAEA,KAAAU,QAAA;QACAC,OAAA,EAAAF,GAAA,CAAAE,OAAA;QACAC,IAAA,EAAAH,GAAA,CAAAI,IAAA;MACA;MACA,IAAAJ,GAAA,CAAAI,IAAA;QACA,KAAAC,OAAA,MAAAd,IAAA;QACAe,UAAA;UACA,KAAAC,OAAA,CAAAC,EAAA;QACA;MACA;IAEA;IACAC,eAAAC,IAAA;MACA,IAAAC,OAAA,GAAAD,IAAA,CAAAE,IAAA;MACA,MAAArB,IAAA,OAAAsB,QAAA;MACAtB,IAAA,CAAAuB,MAAA,UAAAH,OAAA;MACA7B,OAAA,CAAAiC,IAAA,sBAAAxB,IAAA,UAAAyB,IAAA,CAAAC,IAAA;QACA;QACA,KAAA1B,IAAA,CAAAI,IAAA,GAAAsB,IAAA,CAAA9B,IAAA,CAAA+B,QAAA;QACA,KAAA1B,QAAA;UACAN,IAAA,OAAAK,IAAA,CAAAI,IAAA;UACAC,GAAA,OAAAC,YAAA,QAAAN,IAAA,CAAAI;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}