{"ast":null,"code":"import { loginAPI, getUserInfoByTokenAPI } from '@/api/system';\nimport { mapMutations } from 'vuex';\nimport { setToken } from '@/utils/auth';\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      loginForm: {\n        role: 1,\n        username: '',\n        password: \"1\"\n      }\n    };\n  },\n  methods: {\n    ...mapMutations(['setUser', 'setRole', 'setToken']),\n    async login() {\n      const res = await loginAPI(this.loginForm);\n      this.$message({\n        type: res.flag ? 'success' : 'error',\n        message: res.message\n      });\n      if (res.flag) {\n        //设置token\n        setToken(res.data);\n        this.setToken(res.data);\n        //请求用户信息\n        const result = await getUserInfoByTokenAPI();\n        this.setUser(result.data);\n        this.setRole(this.loginForm.role);\n        //跳转\n        this.$router.replace(this.loginForm.role == 1 ? \"/admin\" : \"/front\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["loginAPI","getUserInfoByTokenAPI","mapMutations","setToken","name","data","loginForm","role","username","password","methods","login","res","$message","type","flag","message","result","setUser","setRole","$router","replace"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\r\n    <div class=\"container\">\r\n        <div class=\"login-box\">\r\n            <h2 class=\"title\" @click=\"$router.push('/front')\">{{ $sysTitle }}-登录</h2>\r\n            <el-form :model=\"loginForm\" label-position=\"left\">\r\n                <el-form-item>\r\n                    <el-input v-model=\"loginForm.username\" placeholder=\"请输入账户\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item>\r\n                    <el-input v-model=\"loginForm.password\" type=\"password\" placeholder=\"请输入密码\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item>\r\n                    <el-radio-group v-model=\"loginForm.role\">\r\n                        <el-radio :label=\"1\">管理员</el-radio>\r\n                        <el-radio :label=\"2\">用户</el-radio>\r\n                    </el-radio-group>\r\n                </el-form-item>\r\n                <el-form-item>\r\n                    <el-button type=\"primary\" style=\"width: 100%;\" @click=\"login\">登 录</el-button>\r\n                    <div class=\"text-right\">\r\n                        没有账号?去<router-link to=\"/register\">注册</router-link>\r\n                    </div>\r\n                </el-form-item>\r\n            </el-form>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport { loginAPI, getUserInfoByTokenAPI } from '@/api/system'\r\nimport { mapMutations } from 'vuex'\r\nimport { setToken } from '@/utils/auth'\r\nexport default {\r\n    name: 'Login',\r\n    data() {\r\n        return {\r\n            loginForm: {\r\n                role: 1,\r\n                username: '',\r\n                password: \"1\"\r\n            }\r\n        }\r\n    },\r\n    methods: {\r\n        ...mapMutations(['setUser','setRole','setToken']),\r\n        async login() {\r\n            const res = await loginAPI(this.loginForm)\r\n            this.$message({\r\n                type: res.flag ? 'success' : 'error',\r\n                message: res.message\r\n            })\r\n            if (res.flag) {\r\n                //设置token\r\n                setToken(res.data)\r\n                this.setToken(res.data)\r\n                //请求用户信息\r\n                const result = await getUserInfoByTokenAPI()\r\n                this.setUser(result.data)\r\n                this.setRole(this.loginForm.role)\r\n                //跳转\r\n                this.$router.replace(this.loginForm.role == 1?\"/admin\":\"/front\")\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.container {\r\n    width: 100vw;\r\n    height: 100vh;\r\n    background: linear-gradient(135deg, #304156 0%, #409eff 100%);\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n\r\n    .login-box {\r\n        padding: 36px 40px;\r\n        border-radius: 12px;\r\n        width: 420px;\r\n        background: #fff;\r\n        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);\r\n\r\n        .title {\r\n            text-align: center;\r\n            cursor: pointer;\r\n            font-size: 20px;\r\n            font-weight: 600;\r\n            color: #303133;\r\n            margin-bottom: 24px;\r\n            &:hover { color: #409eff; }\r\n        }\r\n    }\r\n}\r\n</style>\r\n"],"mappings":"AA6BA,SAAAA,QAAA,EAAAC,qBAAA;AACA,SAAAC,YAAA;AACA,SAAAC,QAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;QACAC,IAAA;QACAC,QAAA;QACAC,QAAA;MACA;IACA;EACA;EACAC,OAAA;IACA,GAAAR,YAAA;IACA,MAAAS,MAAA;MACA,MAAAC,GAAA,SAAAZ,QAAA,MAAAM,SAAA;MACA,KAAAO,QAAA;QACAC,IAAA,EAAAF,GAAA,CAAAG,IAAA;QACAC,OAAA,EAAAJ,GAAA,CAAAI;MACA;MACA,IAAAJ,GAAA,CAAAG,IAAA;QACA;QACAZ,QAAA,CAAAS,GAAA,CAAAP,IAAA;QACA,KAAAF,QAAA,CAAAS,GAAA,CAAAP,IAAA;QACA;QACA,MAAAY,MAAA,SAAAhB,qBAAA;QACA,KAAAiB,OAAA,CAAAD,MAAA,CAAAZ,IAAA;QACA,KAAAc,OAAA,MAAAb,SAAA,CAAAC,IAAA;QACA;QACA,KAAAa,OAAA,CAAAC,OAAA,MAAAf,SAAA,CAAAC,IAAA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}