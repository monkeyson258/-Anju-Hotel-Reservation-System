{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport * as echarts from 'echarts';\nimport { getIntelligenceAPI } from '@/api/stats';\nexport default {\n  name: 'Intelligence',\n  data() {\n    return {\n      loading: false,\n      avgRate: 0,\n      warnings: [],\n      suggestions: [],\n      dailyRates: [],\n      categorySales: [],\n      charts: []\n    };\n  },\n  computed: {\n    rateColor() {\n      if (this.avgRate < 30) return '#f56c6c';\n      if (this.avgRate > 80) return '#e6a23c';\n      return '#67c23a';\n    }\n  },\n  mounted() {\n    this.fetchData();\n    window.addEventListener('resize', this.handleResize);\n  },\n  beforeDestroy() {\n    window.removeEventListener('resize', this.handleResize);\n    this.charts.forEach(c => c.dispose());\n  },\n  methods: {\n    async fetchData() {\n      this.loading = true;\n      try {\n        const {\n          data\n        } = await getIntelligenceAPI();\n        this.avgRate = data.avgOccupancyRate || 0;\n        this.warnings = data.warnings || [];\n        this.suggestions = data.categorySuggestions || [];\n        this.dailyRates = data.dailyRates || [];\n        this.categorySales = data.categorySales || [];\n        this.$nextTick(() => {\n          this.renderRateChart();\n          this.renderSalesChart();\n        });\n      } finally {\n        this.loading = false;\n      }\n    },\n    suggestionType(type) {\n      return {\n        hot: 'success',\n        cold: 'warning',\n        info: 'primary'\n      }[type] || 'primary';\n    },\n    suggestionIcon(type) {\n      return {\n        hot: 'el-icon-top',\n        cold: 'el-icon-bottom',\n        info: 'el-icon-info'\n      }[type] || 'el-icon-info';\n    },\n    renderRateChart() {\n      const chart = echarts.init(this.$refs.rateChart);\n      this.charts.push(chart);\n      chart.setOption({\n        tooltip: {\n          trigger: 'axis',\n          formatter: '{b}<br/>入住率: {c}%'\n        },\n        grid: {\n          left: 50,\n          right: 20,\n          top: 20,\n          bottom: 30\n        },\n        xAxis: {\n          type: 'category',\n          data: this.dailyRates.map(d => d.date.substring(5)),\n          axisLabel: {\n            color: '#666'\n          }\n        },\n        yAxis: {\n          type: 'value',\n          max: 100,\n          axisLabel: {\n            formatter: '{value}%',\n            color: '#666'\n          }\n        },\n        series: [{\n          type: 'bar',\n          data: this.dailyRates.map(d => d.occupancyRate),\n          itemStyle: {\n            color: params => {\n              const v = params.value;\n              if (v < 30) return '#f56c6c';\n              if (v > 80) return '#e6a23c';\n              return '#409eff';\n            },\n            borderRadius: [4, 4, 0, 0]\n          }\n        }]\n      });\n    },\n    renderSalesChart() {\n      const chart = echarts.init(this.$refs.salesChart);\n      this.charts.push(chart);\n      chart.setOption({\n        tooltip: {\n          trigger: 'axis'\n        },\n        grid: {\n          left: 50,\n          right: 20,\n          top: 20,\n          bottom: 60\n        },\n        xAxis: {\n          type: 'category',\n          data: this.categorySales.map(c => c.categoryName),\n          axisLabel: {\n            rotate: 30,\n            color: '#666'\n          }\n        },\n        yAxis: {\n          type: 'value',\n          minInterval: 1,\n          axisLabel: {\n            color: '#666'\n          }\n        },\n        series: [{\n          name: '订单量',\n          type: 'bar',\n          barWidth: '35%',\n          data: this.categorySales.map(c => c.orderCount),\n          itemStyle: {\n            color: '#409eff',\n            borderRadius: [4, 4, 0, 0]\n          }\n        }]\n      });\n    },\n    handleResize() {\n      this.charts.forEach(c => c.resize());\n    }\n  }\n};","map":{"version":3,"names":["echarts","getIntelligenceAPI","name","data","loading","avgRate","warnings","suggestions","dailyRates","categorySales","charts","computed","rateColor","mounted","fetchData","window","addEventListener","handleResize","beforeDestroy","removeEventListener","forEach","c","dispose","methods","avgOccupancyRate","categorySuggestions","$nextTick","renderRateChart","renderSalesChart","suggestionType","type","hot","cold","info","suggestionIcon","chart","init","$refs","rateChart","push","setOption","tooltip","trigger","formatter","grid","left","right","top","bottom","xAxis","map","d","date","substring","axisLabel","color","yAxis","max","series","occupancyRate","itemStyle","params","v","value","borderRadius","salesChart","categoryName","rotate","minInterval","barWidth","orderCount","resize"],"sources":["src/views/Intelligence.vue"],"sourcesContent":["<template>\r\n  <div class=\"intelligence-page\" v-loading=\"loading\">\r\n    <el-row :gutter=\"16\">\r\n      <el-col :span=\"8\">\r\n        <el-card shadow=\"hover\" class=\"rate-card\">\r\n          <div class=\"rate-circle\">\r\n            <el-progress\r\n              type=\"circle\"\r\n              :percentage=\"Math.min(avgRate, 100)\"\r\n              :width=\"160\"\r\n              :color=\"rateColor\"\r\n              :format=\"() => avgRate + '%'\"\r\n            ></el-progress>\r\n          </div>\r\n          <div class=\"rate-label\">近7天平均入住率</div>\r\n        </el-card>\r\n      </el-col>\r\n      <el-col :span=\"16\">\r\n        <el-card shadow=\"hover\" class=\"warning-card\">\r\n          <div slot=\"header\"><i class=\"el-icon-warning-outline\"></i> 智能预警</div>\r\n          <div v-for=\"(w, i) in warnings\" :key=\"i\" class=\"warning-item\">\r\n            <el-alert\r\n              :title=\"w.title\"\r\n              :type=\"w.level === 'danger' ? 'error' : w.level\"\r\n              :description=\"w.message\"\r\n              show-icon\r\n              :closable=\"false\"\r\n              class=\"mb-10\"\r\n            ></el-alert>\r\n            <div class=\"suggestion\" v-if=\"w.suggestion\">\r\n              <i class=\"el-icon-magic-stick\"></i> {{ w.suggestion }}\r\n            </div>\r\n          </div>\r\n        </el-card>\r\n      </el-col>\r\n    </el-row>\r\n\r\n    <el-row :gutter=\"16\" class=\"mt-16\">\r\n      <el-col :span=\"12\">\r\n        <el-card shadow=\"hover\">\r\n          <div slot=\"header\"><i class=\"el-icon-data-line\"></i> 每日入住率走势</div>\r\n          <div ref=\"rateChart\" class=\"chart-box\"></div>\r\n        </el-card>\r\n      </el-col>\r\n      <el-col :span=\"12\">\r\n        <el-card shadow=\"hover\">\r\n          <div slot=\"header\"><i class=\"el-icon-s-data\"></i> 房型销量分析（近30天）</div>\r\n          <div ref=\"salesChart\" class=\"chart-box\"></div>\r\n        </el-card>\r\n      </el-col>\r\n    </el-row>\r\n\r\n    <el-card shadow=\"hover\" class=\"mt-16\">\r\n      <div slot=\"header\"><i class=\"el-icon-s-opportunity\"></i> 智能运营建议</div>\r\n      <el-timeline>\r\n        <el-timeline-item\r\n          v-for=\"(s, i) in suggestions\"\r\n          :key=\"i\"\r\n          :type=\"suggestionType(s.type)\"\r\n          :icon=\"suggestionIcon(s.type)\"\r\n        >\r\n          <h4>{{ s.title }}</h4>\r\n          <p>{{ s.message }}</p>\r\n          <p v-if=\"s.suggestion\" class=\"suggestion-text\">{{ s.suggestion }}</p>\r\n        </el-timeline-item>\r\n      </el-timeline>\r\n      <el-empty v-if=\"!suggestions.length\" description=\"暂无建议\"></el-empty>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport * as echarts from 'echarts'\r\nimport { getIntelligenceAPI } from '@/api/stats'\r\n\r\nexport default {\r\n  name: 'Intelligence',\r\n  data() {\r\n    return {\r\n      loading: false,\r\n      avgRate: 0,\r\n      warnings: [],\r\n      suggestions: [],\r\n      dailyRates: [],\r\n      categorySales: [],\r\n      charts: []\r\n    }\r\n  },\r\n  computed: {\r\n    rateColor() {\r\n      if (this.avgRate < 30) return '#f56c6c'\r\n      if (this.avgRate > 80) return '#e6a23c'\r\n      return '#67c23a'\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchData()\r\n    window.addEventListener('resize', this.handleResize)\r\n  },\r\n  beforeDestroy() {\r\n    window.removeEventListener('resize', this.handleResize)\r\n    this.charts.forEach(c => c.dispose())\r\n  },\r\n  methods: {\r\n    async fetchData() {\r\n      this.loading = true\r\n      try {\r\n        const { data } = await getIntelligenceAPI()\r\n        this.avgRate = data.avgOccupancyRate || 0\r\n        this.warnings = data.warnings || []\r\n        this.suggestions = data.categorySuggestions || []\r\n        this.dailyRates = data.dailyRates || []\r\n        this.categorySales = data.categorySales || []\r\n        this.$nextTick(() => {\r\n          this.renderRateChart()\r\n          this.renderSalesChart()\r\n        })\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    suggestionType(type) {\r\n      return { hot: 'success', cold: 'warning', info: 'primary' }[type] || 'primary'\r\n    },\r\n    suggestionIcon(type) {\r\n      return { hot: 'el-icon-top', cold: 'el-icon-bottom', info: 'el-icon-info' }[type] || 'el-icon-info'\r\n    },\r\n    renderRateChart() {\r\n      const chart = echarts.init(this.$refs.rateChart)\r\n      this.charts.push(chart)\r\n      chart.setOption({\r\n        tooltip: { trigger: 'axis', formatter: '{b}<br/>入住率: {c}%' },\r\n        grid: { left: 50, right: 20, top: 20, bottom: 30 },\r\n        xAxis: {\r\n          type: 'category',\r\n          data: this.dailyRates.map(d => d.date.substring(5)),\r\n          axisLabel: { color: '#666' }\r\n        },\r\n        yAxis: { type: 'value', max: 100, axisLabel: { formatter: '{value}%', color: '#666' } },\r\n        series: [{\r\n          type: 'bar', data: this.dailyRates.map(d => d.occupancyRate),\r\n          itemStyle: {\r\n            color: params => {\r\n              const v = params.value\r\n              if (v < 30) return '#f56c6c'\r\n              if (v > 80) return '#e6a23c'\r\n              return '#409eff'\r\n            },\r\n            borderRadius: [4, 4, 0, 0]\r\n          }\r\n        }]\r\n      })\r\n    },\r\n    renderSalesChart() {\r\n      const chart = echarts.init(this.$refs.salesChart)\r\n      this.charts.push(chart)\r\n      chart.setOption({\r\n        tooltip: { trigger: 'axis' },\r\n        grid: { left: 50, right: 20, top: 20, bottom: 60 },\r\n        xAxis: {\r\n          type: 'category',\r\n          data: this.categorySales.map(c => c.categoryName),\r\n          axisLabel: { rotate: 30, color: '#666' }\r\n        },\r\n        yAxis: { type: 'value', minInterval: 1, axisLabel: { color: '#666' } },\r\n        series: [{\r\n          name: '订单量', type: 'bar', barWidth: '35%',\r\n          data: this.categorySales.map(c => c.orderCount),\r\n          itemStyle: { color: '#409eff', borderRadius: [4, 4, 0, 0] }\r\n        }]\r\n      })\r\n    },\r\n    handleResize() {\r\n      this.charts.forEach(c => c.resize())\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.intelligence-page { padding: 0; }\r\n\r\n.rate-card {\r\n  text-align: center;\r\n  .rate-circle { padding: 20px 0 10px; }\r\n  .rate-label { font-size: 15px; color: #606266; font-weight: 600; padding-bottom: 10px; }\r\n}\r\n\r\n.warning-item { margin-bottom: 12px; }\r\n\r\n.suggestion {\r\n  padding: 8px 12px;\r\n  background: #f0f9eb;\r\n  border-radius: 4px;\r\n  color: #67c23a;\r\n  font-size: 13px;\r\n  margin-bottom: 12px;\r\n  i { margin-right: 4px; }\r\n}\r\n\r\n.chart-box { height: 300px; }\r\n\r\n.mt-16 { margin-top: 16px; }\r\n.mb-10 { margin-bottom: 10px; }\r\n\r\n.suggestion-text { color: #909399; font-size: 13px; }\r\n</style>\r\n"],"mappings":";AAwEA,YAAAA,OAAA;AACA,SAAAC,kBAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,OAAA;MACAC,QAAA;MACAC,WAAA;MACAC,UAAA;MACAC,aAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA;IACAC,UAAA;MACA,SAAAP,OAAA;MACA,SAAAA,OAAA;MACA;IACA;EACA;EACAQ,QAAA;IACA,KAAAC,SAAA;IACA