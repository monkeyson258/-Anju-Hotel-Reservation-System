{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { chatAPI } from '@/api/ai';\nexport default {\n  name: 'AiChat',\n  props: {\n    greeting: {\n      type: String,\n      default: '您好！我是斌安居酒店智能客服，可以为您解答房型价格、预订方式、酒店设施等问题。'\n    }\n  },\n  data() {\n    return {\n      visible: false,\n      inputText: '',\n      loading: false,\n      messages: [],\n      quickQuestions: ['有哪些房型？', '现在能预订吗？', '酒店在哪里？', '价格是多少？']\n    };\n  },\n  methods: {\n    toggleChat() {\n      this.visible = !this.visible;\n      if (this.visible && this.messages.length === 0) {\n        this.messages.push({\n          role: 'assistant',\n          content: this.greeting\n        });\n      }\n      this.$nextTick(() => this.scrollToBottom());\n    },\n    formatMsg(text) {\n      return text.replace(/\\n/g, '<br>');\n    },\n    sendQuick(q) {\n      this.inputText = q;\n      this.sendMessage();\n    },\n    async sendMessage() {\n      const text = this.inputText.trim();\n      if (!text || this.loading) return;\n      this.messages.push({\n        role: 'user',\n        content: text\n      });\n      this.inputText = '';\n      this.loading = true;\n      this.$nextTick(() => this.scrollToBottom());\n      try {\n        const history = this.messages.slice(0, -1).slice(-10).map(m => ({\n          role: m.role === 'assistant' ? 'assistant' : 'user',\n          content: m.content\n        }));\n        const {\n          data\n        } = await chatAPI({\n          message: text,\n          history\n        });\n        this.messages.push({\n          role: 'assistant',\n          content: data.reply\n        });\n      } catch (e) {\n        this.messages.push({\n          role: 'assistant',\n          content: '抱歉，暂时无法回复，请稍后再试。'\n        });\n      } finally {\n        this.loading = false;\n        this.$nextTick(() => this.scrollToBottom());\n      }\n    },\n    scrollToBottom() {\n      const body = this.$refs.chatBody;\n      if (body) body.scrollTop = body.scrollHeight;\n    }\n  }\n};","map":{"version":3,"names":["chatAPI","name","props","greeting","type","String","default","data","visible","inputText","loading","messages","quickQuestions","methods","toggleChat","length","push","role","content","$nextTick","scrollToBottom","formatMsg","text","replace","sendQuick","q","sendMessage","trim","history","slice","map","m","message","reply","e","body","$refs","chatBody","scrollTop","scrollHeight"],"sources":["src/components/AiChat.vue"],"sourcesContent":["<template>\r\n  <div class=\"ai-chat-wrapper\">\r\n    <transition name=\"chat-fade\">\r\n      <div v-if=\"visible\" class=\"ai-chat-panel\">\r\n        <div class=\"chat-header\">\r\n          <div class=\"header-info\">\r\n            <i class=\"el-icon-service\"></i>\r\n            <span>智能客服</span>\r\n            <el-tag size=\"mini\" type=\"success\" effect=\"plain\">AI</el-tag>\r\n          </div>\r\n          <i class=\"el-icon-close close-btn\" @click=\"visible = false\"></i>\r\n        </div>\r\n        <div class=\"chat-body\" ref=\"chatBody\">\r\n          <div v-for=\"(msg, index) in messages\" :key=\"index\" :class=\"['chat-msg', msg.role]\">\r\n            <div class=\"msg-avatar\">\r\n              <i :class=\"msg.role === 'user' ? 'el-icon-user' : 'el-icon-service'\"></i>\r\n            </div>\r\n            <div class=\"msg-content\">\r\n              <div class=\"msg-text\" v-html=\"formatMsg(msg.content)\"></div>\r\n            </div>\r\n          </div>\r\n          <div v-if=\"loading\" class=\"chat-msg assistant\">\r\n            <div class=\"msg-avatar\"><i class=\"el-icon-service\"></i></div>\r\n            <div class=\"msg-content\">\r\n              <div class=\"msg-text typing\"><span></span><span></span><span></span></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"chat-quick\" v-if=\"messages.length <= 1\">\r\n          <el-tag\r\n            v-for=\"q in quickQuestions\"\r\n            :key=\"q\"\r\n            size=\"small\"\r\n            effect=\"plain\"\r\n            class=\"quick-tag\"\r\n            @click=\"sendQuick(q)\"\r\n          >{{ q }}</el-tag>\r\n        </div>\r\n        <div class=\"chat-footer\">\r\n          <el-input\r\n            v-model=\"inputText\"\r\n            placeholder=\"请输入您的问题...\"\r\n            size=\"small\"\r\n            @keyup.enter.native=\"sendMessage\"\r\n            :disabled=\"loading\"\r\n          >\r\n            <el-button slot=\"append\" icon=\"el-icon-s-promotion\" @click=\"sendMessage\" :loading=\"loading\">发送</el-button>\r\n          </el-input>\r\n        </div>\r\n      </div>\r\n    </transition>\r\n    <div class=\"ai-chat-trigger\" @click=\"toggleChat\">\r\n      <i class=\"el-icon-chat-dot-round\"></i>\r\n      <span v-if=\"!visible\" class=\"trigger-label\">智能客服</span>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { chatAPI } from '@/api/ai'\r\n\r\nexport default {\r\n  name: 'AiChat',\r\n  props: {\r\n    greeting: {\r\n      type: String,\r\n      default: '您好！我是斌安居酒店智能客服，可以为您解答房型价格、预订方式、酒店设施等问题。'\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      visible: false,\r\n      inputText: '',\r\n      loading: false,\r\n      messages: [],\r\n      quickQuestions: ['有哪些房型？', '现在能预订吗？', '酒店在哪里？', '价格是多少？']\r\n    }\r\n  },\r\n  methods: {\r\n    toggleChat() {\r\n      this.visible = !this.visible\r\n      if (this.visible && this.messages.length === 0) {\r\n        this.messages.push({ role: 'assistant', content: this.greeting })\r\n      }\r\n      this.$nextTick(() => this.scrollToBottom())\r\n    },\r\n    formatMsg(text) {\r\n      return text.replace(/\\n/g, '<br>')\r\n    },\r\n    sendQuick(q) {\r\n      this.inputText = q\r\n      this.sendMessage()\r\n    },\r\n    async sendMessage() {\r\n      const text = this.inputText.trim()\r\n      if (!text || this.loading) return\r\n      this.messages.push({ role: 'user', content: text })\r\n      this.inputText = ''\r\n      this.loading = true\r\n      this.$nextTick(() => this.scrollToBottom())\r\n      try {\r\n        const history = this.messages.slice(0, -1).slice(-10).map(m => ({\r\n          role: m.role === 'assistant' ? 'assistant' : 'user',\r\n          content: m.content\r\n        }))\r\n        const { data } = await chatAPI({ message: text, history })\r\n        this.messages.push({ role: 'assistant', content: data.reply })\r\n      } catch (e) {\r\n        this.messages.push({ role: 'assistant', content: '抱歉，暂时无法回复，请稍后再试。' })\r\n      } finally {\r\n        this.loading = false\r\n        this.$nextTick(() => this.scrollToBottom())\r\n      }\r\n    },\r\n    scrollToBottom() {\r\n      const body = this.$refs.chatBody\r\n      if (body) body.scrollTop = body.scrollHeight\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.ai-chat-wrapper {\r\n  position: fixed;\r\n  right: 24px;\r\n  bottom: 24px;\r\n  z-index: 2000;\r\n}\r\n\r\n.ai-chat-trigger {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  background: linear-gradient(135deg, #409eff, #337ecc);\r\n  color: #fff;\r\n  padding: 12px 20px;\r\n  border-radius: 28px;\r\n  cursor: pointer;\r\n  box-shadow: 0 4px 16px rgba(64, 158, 255, 0.4);\r\n  transition: all 0.3s;\r\n  font-size: 14px;\r\n\r\n  i { font-size: 22px; }\r\n\r\n  &:hover {\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 6px 20px rgba(64, 158, 255, 0.5);\r\n  }\r\n}\r\n\r\n.ai-chat-panel {\r\n  position: absolute;\r\n  right: 0;\r\n  bottom: 60px;\r\n  width: 380px;\r\n  height: 520px;\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n}\r\n\r\n.chat-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 14px 16px;\r\n  background: linear-gradient(135deg, #409eff, #337ecc);\r\n  color: #fff;\r\n\r\n  .header-info {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    font-size: 15px;\r\n    font-weight: 600;\r\n  }\r\n\r\n  .close-btn {\r\n    cursor: pointer;\r\n    font-size: 18px;\r\n    opacity: 0.8;\r\n    &:hover { opacity: 1; }\r\n  }\r\n}\r\n\r\n.chat-body {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 16px;\r\n  background: #f5f7fa;\r\n}\r\n\r\n.chat-msg {\r\n  display: flex;\r\n  gap: 8px;\r\n  margin-bottom: 14px;\r\n\r\n  &.user {\r\n    flex-direction: row-reverse;\r\n    .msg-content { align-items: flex-end; }\r\n    .msg-text { background: #409eff; color: #fff; border-radius: 12px 2px 12px 12px; }\r\n    .msg-avatar { background: #409eff; }\r\n  }\r\n\r\n  &.assistant {\r\n    .msg-text { background: #fff; color: #333; border-radius: 2px 12px 12px 12px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }\r\n    .msg-avatar { background: #67c23a; }\r\n  }\r\n}\r\n\r\n.msg-avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #fff;\r\n  flex-shrink: 0;\r\n  font-size: 16px;\r\n}\r\n\r\n.msg-content { display: flex; flex-direction: column; max-width: 75%; }\r\n\r\n.msg-text {\r\n  padding: 10px 14px;\r\n  font-size: 13px;\r\n  line-height: 1.6;\r\n  word-break: break-word;\r\n}\r\n\r\n.typing span {\r\n  display: inline-block;\r\n  width: 6px;\r\n  height: 6px;\r\n  background: #999;\r\n  border-radius: 50%;\r\n  margin: 0 2px;\r\n  animation: blink 1.4s infinite both;\r\n  &:nth-child(2) { animation-delay: 0.2s; }\r\n  &:nth-child(3) { animation-delay: 0.4s; }\r\n}\r\n\r\n@keyframes blink {\r\n  0%, 80%, 100% { opacity: 0.3; }\r\n  40% { opacity: 1; }\r\n}\r\n\r\n.chat-quick {\r\n  padding: 0 16px 8px;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n  background: #f5f7fa;\r\n\r\n  .quick-tag {\r\n    cursor: pointer;\r\n    &:hover { color: #409eff; border-color: #409eff; }\r\n  }\r\n}\r\n\r\n.chat-footer {\r\n  padding: 12px 16px;\r\n  border-top: 1px solid #eee;\r\n  background: #fff;\r\n}\r\n\r\n.chat-fade-enter-active, .chat-fade-leave-active {\r\n  transition: all 0.3s;\r\n}\r\n.chat-fade-enter, .chat-fade-leave-to {\r\n  opacity: 0;\r\n  transform: translateY(10px);\r\n}\r\n</style>\r\n"],"mappings":";AA2DA,SAAAA,OAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,QAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,cAAA;IACA;EACA;EACAC,OAAA;IACAC,WAAA;MACA,KAAAN,OAAA,SAAAA,OAAA;MACA,SAAAA,OAAA,SAAAG,QAAA,CAAAI,MAAA;QACA,KAAAJ,QAAA,CAAAK,IAAA;UAAAC,IAAA;UAAAC,OAAA,OAAAf;QAAA;MACA;MACA,KAAAgB,SAAA,YAAAC,cAAA;IACA;IACAC,UAAAC,IAAA;MACA,OAAAA,IAAA,CAAAC,OAAA;IACA;IACAC,UAAAC,CAAA;MACA,KAAAhB,SAAA,GAAAgB,CAAA;MACA,KAAAC,WAAA;IACA;IACA,MAAAA,YAAA;MACA,MAAAJ,IAAA,QAAAb,SAAA,CAAAkB,IAAA;MACA,KAAAL,IAAA,SAAAZ,OAAA;MACA,KAAAC,QAAA,CAAAK,IAAA;QAAAC,IAAA;QAAAC,OAAA,EAAAI;MAAA;MACA,KAAAb,SAAA;MACA,KAAAC,OAAA;MACA,KAAAS,SAAA,YAAAC,cAAA;MACA;QACA,MAAAQ,OAAA,QAAAjB,QAAA,CAAAkB,KAAA,QAAAA,KAAA,MAAAC,GAAA,CAAAC,CAAA;UACAd,IAAA,EAAAc,CAAA,CAAAd,IAAA;UACAC,OAAA,EAAAa,CAAA,CAAAb;QACA;QACA;UAAAX;QAAA,UAAAP,OAAA;UAAAgC,OAAA,EAAAV,IAAA;UAAAM;QAAA;QACA,KAAAjB,QAAA,CAAAK,IAAA;UAAAC,IAAA;UAAAC,OAAA,EAAAX,IAAA,CAAA0B;QAAA;MACA,SAAAC,CAAA;QACA,KAAAvB,QAAA,CAAAK,IAAA;UAAAC,IAAA;UAAAC,OAAA;QAAA;MACA;QACA,KAAAR,OAAA;QACA,KAAAS,SAAA,YAAAC,cAAA;MACA;IACA;IACAA,eAAA;MACA,MAAAe,IAAA,QAAAC,KAAA,CAAAC,QAAA;MACA,IAAAF,IAAA,EAAAA,IAAA,CAAAG,SAAA,GAAAH,IAAA,CAAAI,YAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}