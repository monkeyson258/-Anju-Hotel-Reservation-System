{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { findMessagePageAPI, addMessageAPI } from \"@/api/message\";\nimport { mapState } from 'vuex';\nexport default {\n  name: 'FrontMessage',\n  data() {\n    return {\n      list: [],\n      listLoading: false,\n      pageSize: 10,\n      pageNum: 1,\n      total: 0,\n      showDialog: false,\n      dialogForm: {}\n    };\n  },\n  created() {\n    this.fetchData();\n  },\n  computed: {\n    ...mapState(['user', 'role', 'token'])\n  },\n  methods: {\n    handleDialogClose() {\n      this.showDialog = false;\n    },\n    handleSizeChange(val) {\n      //每页显示条数改变\n      this.pageSize = val;\n      this.fetchData();\n    },\n    handleCurrentChange(val) {\n      //当前页码改变\n      this.pageNum = val;\n      this.fetchData();\n    },\n    handleSearch() {\n      //点击搜索按钮\n      this.fetchData();\n    },\n    async fetchData() {\n      //查询数据\n      this.listLoading = true;\n      let response = await findMessagePageAPI(this.pageNum, this.pageSize, this.searchForm);\n      this.list = response.data.records;\n      this.total = response.data.total;\n      this.listLoading = false;\n    },\n    //点击吐槽按钮\n    handleAddClick() {\n      if (!this.token) {\n        this.$message({\n          type: 'error',\n          message: '请先登录！'\n        });\n        setTimeout(() => this.$router.push('/login'), 1000);\n        return;\n      }\n      this.showDialog = true;\n    },\n    //点击吐槽弹框确认按钮\n    async dialogConfirm() {\n      if (this.dialogForm.comment == '' || this.dialogForm.comment == null) {\n        this.$message({\n          message: \"内容不能为空！\",\n          type: \"error\"\n        });\n        return;\n      }\n      const res = await addMessageAPI(this.dialogForm);\n      this.$message({\n        message: res.message,\n        type: res.flag ? \"success\" : \"error\"\n      });\n      if (res.flag) {\n        this.showDialog = false;\n        this.fetchData();\n      }\n    }\n  }\n};","map":{"version":3,"names":["findMessagePageAPI","addMessageAPI","mapState","name","data","list","listLoading","pageSize","pageNum","total","showDialog","dialogForm","created","fetchData","computed","methods","handleDialogClose","handleSizeChange","val","handleCurrentChange","handleSearch","response","searchForm","records","handleAddClick","token","$message","type","message","setTimeout","$router","push","dialogConfirm","comment","res","flag"],"sources":["src/views/front/Message.vue"],"sourcesContent":["<template>\r\n    <div class=\"page-container\">\r\n        <el-card>\r\n            <div slot=\"header\" class=\"clearfix\">\r\n                <span>用户留言（{{ total }}）</span>\r\n                <el-button @click=\"handleAddClick\" style=\"float: right; padding: 3px 0\" type=\"text\">吐槽一下</el-button>\r\n            </div>\r\n            <div class=\"message-list\" v-loading=\"listLoading\">\r\n\r\n                <div class=\"message-item\" v-for=\"item in list\" :key=\"item.id\">\r\n                    <div class=\"comment-head\">\r\n                        <img :src=\"$baseFileUrl + item.member.head\" class=\"head\" />\r\n                    </div>\r\n                    <div class=\"comment-detail p-10\">\r\n                        <!-- 评论内容 -->\r\n                        <div class=\"text-bold\">{{ item.member.name }}</div>\r\n                        <div class=\"comment-content font-14 my-10\">{{ item.comment }}</div>\r\n                        <div class=\"text-gray mb-10 font-14\">{{ item.createTime }}</div>\r\n                        <!-- 回复内容 -->\r\n                        <div class=\"reply p-y\" v-show=\"item?.reply\">\r\n                            <div class=\"reply-head\">\r\n                                <img src=\"@/assets/head.jpg\" class=\"head\" />\r\n                            </div>\r\n                            <div class=\"reply-detail\">\r\n                                <div class=\"text-bold\">管理员回复</div>\r\n                                <div class=\"reply-content font-14 my-10\">{{ item.reply }}</div>\r\n                                <div class=\"text-gray font-14\">{{ item.replyTime }}</div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n            </div>\r\n            <el-pagination class=\"page-box\" background @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\r\n                :current-page=\"pageNum\" :page-sizes=\"[10, 20]\" :page-size=\"pageSize\"\r\n                layout=\"total, sizes, prev, pager, next, jumper\" :total=\"total\">\r\n            </el-pagination>\r\n        </el-card>\r\n        <el-dialog title=\"留言\" :visible.sync=\"showDialog\" :before-close=\"handleDialogClose\">\r\n            <el-input type=\"textarea\" :rows=\"4\" placeholder=\"请输入你的留言\" v-model=\"dialogForm.comment\">\r\n            </el-input>\r\n            <span slot=\"footer\" class=\"dialog-footer\">\r\n                <el-button @click=\"showDialog = false\">取 消</el-button>\r\n                <el-button type=\"primary\" @click=\"dialogConfirm\">确 定</el-button>\r\n            </span>\r\n        </el-dialog>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport { findMessagePageAPI, addMessageAPI } from \"@/api/message\";\r\nimport { mapState } from 'vuex'\r\nexport default {\r\n    name: 'FrontMessage',\r\n\r\n    data() {\r\n        return {\r\n            list: [],\r\n            listLoading: false,\r\n            pageSize: 10,\r\n            pageNum: 1,\r\n            total: 0,\r\n            showDialog: false,\r\n            dialogForm: {}\r\n        };\r\n    },\r\n\r\n    created() {\r\n        this.fetchData();\r\n    },\r\n\r\n    computed: {\r\n        ...mapState(['user', 'role', 'token'])\r\n    },\r\n\r\n    methods: {\r\n        handleDialogClose() {\r\n            this.showDialog = false\r\n        },\r\n        handleSizeChange(val) {//每页显示条数改变\r\n            this.pageSize = val;\r\n            this.fetchData();\r\n        },\r\n        handleCurrentChange(val) {//当前页码改变\r\n            this.pageNum = val;\r\n            this.fetchData();\r\n        },\r\n        handleSearch() {//点击搜索按钮\r\n            this.fetchData();\r\n        },\r\n        async fetchData() {//查询数据\r\n            this.listLoading = true;\r\n            let response = await findMessagePageAPI(\r\n                this.pageNum,\r\n                this.pageSize,\r\n                this.searchForm\r\n            );\r\n            this.list = response.data.records;\r\n            this.total = response.data.total;\r\n            this.listLoading = false;\r\n        },\r\n        //点击吐槽按钮\r\n        handleAddClick() {\r\n            if (!this.token) {\r\n                this.$message({ type: 'error', message: '请先登录！' })\r\n                setTimeout(() => this.$router.push('/login'), 1000)\r\n                return\r\n            }\r\n            this.showDialog = true\r\n        },\r\n        //点击吐槽弹框确认按钮\r\n        async dialogConfirm() {\r\n            if(this.dialogForm.comment == '' || this.dialogForm.comment == null){\r\n                this.$message({\r\n                    message: \"内容不能为空！\",\r\n                    type: \"error\",\r\n                });\r\n                return\r\n            }\r\n            const res = await addMessageAPI(this.dialogForm)\r\n            this.$message({\r\n                message: res.message,\r\n                type: res.flag ? \"success\" : \"error\",\r\n            });\r\n            if(res.flag){\r\n                this.showDialog = false\r\n                this.fetchData()\r\n            }\r\n            \r\n        }\r\n    },\r\n};\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.page-container {\r\n    width: 1200px;\r\n    margin: 20px auto;\r\n\r\n    .message-list {\r\n        .message-item {\r\n            display: flex;\r\n            line-height: 1.5;\r\n            margin-bottom: 10px;\r\n            border-bottom: 1px solid #ccc;\r\n            font-size: 14px;\r\n\r\n            &:nth-last-child(1) {\r\n                border-bottom: none;\r\n            }\r\n\r\n            .head {\r\n                width: 40px;\r\n                height: 40px;\r\n                border-radius: 50%;\r\n            }\r\n\r\n            .reply {\r\n                display: flex;\r\n            }\r\n        }\r\n    }\r\n}\r\n</style>"],"mappings":";AAkDA,SAAAA,kBAAA,EAAAC,aAAA;AACA,SAAAC,QAAA;AACA;EACAC,IAAA;EAEAC,KAAA;IACA;MACAC,IAAA;MACAC,WAAA;MACAC,QAAA;MACAC,OAAA;MACAC,KAAA;MACAC,UAAA;MACAC,UAAA;IACA;EACA;EAEAC,QAAA;IACA,KAAAC,SAAA;EACA;EAEAC,QAAA;IACA,GAAAZ,QAAA;EACA;EAEAa,OAAA;IACAC,kBAAA;MACA,KAAAN,UAAA;IACA;IACAO,iBAAAC,GAAA;MAAA;MACA,KAAAX,QAAA,GAAAW,GAAA;MACA,KAAAL,SAAA;IACA;IACAM,oBAAAD,GAAA;MAAA;MACA,KAAAV,OAAA,GAAAU,GAAA;MACA,KAAAL,SAAA;IACA;IACAO,aAAA;MAAA;MACA,KAAAP,SAAA;IACA;IACA,MAAAA,UAAA;MAAA;MACA,KAAAP,WAAA;MACA,IAAAe,QAAA,SAAArB,kBAAA,CACA,KAAAQ,OAAA,EACA,KAAAD,QAAA,EACA,KAAAe,UACA;MACA,KAAAjB,IAAA,GAAAgB,QAAA,CAAAjB,IAAA,CAAAmB,OAAA;MACA,KAAAd,KAAA,GAAAY,QAAA,CAAAjB,IAAA,CAAAK,KAAA;MACA,KAAAH,WAAA;IACA;IACA;IACAkB,eAAA;MACA,UAAAC,KAAA;QACA,KAAAC,QAAA;UAAAC,IAAA;UAAAC,OAAA;QAAA;QACAC,UAAA,YAAAC,OAAA,CAAAC,IAAA;QACA;MACA;MACA,KAAArB,UAAA;IACA;IACA;IACA,MAAAsB,cAAA;MACA,SAAArB,UAAA,CAAAsB,OAAA,eAAAtB,UAAA,CAAAsB,OAAA;QACA,KAAAP,QAAA;UACAE,OAAA;UACAD,IAAA;QACA;QACA;MACA;MACA,MAAAO,GAAA,SAAAjC,aAAA,MAAAU,UAAA;MACA,KAAAe,QAAA;QACAE,OAAA,EAAAM,GAAA,CAAAN,OAAA;QACAD,IAAA,EAAAO,GAAA,CAAAC,IAAA;MACA;MACA,IAAAD,GAAA,CAAAC,IAAA;QACA,KAAAzB,UAAA;QACA,KAAAG,SAAA;MACA;IAEA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}