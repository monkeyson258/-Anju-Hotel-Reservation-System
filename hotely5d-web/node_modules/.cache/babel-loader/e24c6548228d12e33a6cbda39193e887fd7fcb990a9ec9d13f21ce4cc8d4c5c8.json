{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapState, mapMutations } from 'vuex';\nimport { removeToken } from '@/utils/auth';\nexport default {\n  name: 'FrontLayout',\n  data() {\n    return {\n      head: '',\n      year: '',\n      navItems: [{\n        path: '/front',\n        label: '首页'\n      }, {\n        path: '/front/room',\n        label: '预约入住'\n      }, {\n        path: '/front/notice',\n        label: '系统公告'\n      }, {\n        path: '/front/message',\n        label: '用户留言'\n      }]\n    };\n  },\n  computed: {\n    ...mapState(['user', 'role', 'token'])\n  },\n  mounted() {\n    this.year = new Date().getFullYear();\n    this.head = this.user?.head;\n  },\n  methods: {\n    ...mapMutations(['setUser', 'setRole', 'setToken']),\n    isActive(path) {\n      if (path === '/front') {\n        return this.$route.path === '/front' || this.$route.path === '/front/';\n      }\n      return this.$route.path.startsWith(path);\n    },\n    handleCommand(cmd) {\n      const routes = {\n        userInfo: '/front/userInfo',\n        appointment: '/front/appointment',\n        orders: '/front/orders'\n      };\n      if (cmd === 'logout') {\n        this.logout();\n      } else if (routes[cmd]) {\n        this.$router.push(routes[cmd]);\n      }\n    },\n    logout() {\n      this.$confirm('确定退出吗?', '温馨提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        removeToken();\n        this.setUser({});\n        this.setToken('');\n        this.$router.replace('/front');\n      }).catch(() => {});\n    }\n  }\n};","map":{"version":3,"names":["mapState","mapMutations","removeToken","name","data","head","year","navItems","path","label","computed","mounted","Date","getFullYear","user","methods","isActive","$route","startsWith","handleCommand","cmd","routes","userInfo","appointment","orders","logout","$router","push","$confirm","confirmButtonText","cancelButtonText","type","then","setUser","setToken","replace","catch"],"sources":["src/views/front/FrontLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"front-layout\">\r\n    <header class=\"site-header\">\r\n      <div class=\"header-inner\">\r\n        <div class=\"brand\" @click=\"$router.push('/front')\">\r\n          <img src=\"@/assets/logo.png\" class=\"brand-logo\" alt=\"logo\" />\r\n          <div class=\"brand-info\">\r\n            <span class=\"brand-name\">{{ $sysTitle }}</span>\r\n            <span class=\"brand-tagline\">尊享舒适旅居</span>\r\n          </div>\r\n        </div>\r\n\r\n        <nav class=\"main-nav\">\r\n          <router-link\r\n            v-for=\"item in navItems\"\r\n            :key=\"item.path\"\r\n            :to=\"item.path\"\r\n            class=\"nav-item\"\r\n            :class=\"{ active: isActive(item.path) }\"\r\n          >{{ item.label }}</router-link>\r\n        </nav>\r\n\r\n        <div class=\"header-actions\">\r\n          <template v-if=\"!token\">\r\n            <router-link to=\"/login\" class=\"btn-ghost\">登录</router-link>\r\n            <router-link to=\"/register\" class=\"btn-gold\">注册</router-link>\r\n          </template>\r\n          <el-dropdown v-else trigger=\"click\" @command=\"handleCommand\">\r\n            <div class=\"user-pill\">\r\n              <el-avatar v-if=\"head\" :size=\"32\" :src=\"$baseFileUrl + head\"></el-avatar>\r\n              <img v-else src=\"@/assets/head.jpg\" class=\"user-avatar-img\" />\r\n              <span>{{ user?.name }}</span>\r\n              <i class=\"el-icon-arrow-down\"></i>\r\n            </div>\r\n            <el-dropdown-menu slot=\"dropdown\">\r\n              <el-dropdown-item command=\"userInfo\" icon=\"el-icon-user\">个人信息</el-dropdown-item>\r\n              <el-dropdown-item command=\"appointment\" icon=\"el-icon-date\">我的预约</el-dropdown-item>\r\n              <el-dropdown-item command=\"orders\" icon=\"el-icon-s-order\">我的入住</el-dropdown-item>\r\n              <el-dropdown-item command=\"logout\" icon=\"el-icon-switch-button\" divided>退出登录</el-dropdown-item>\r\n            </el-dropdown-menu>\r\n          </el-dropdown>\r\n        </div>\r\n      </div>\r\n    </header>\r\n\r\n    <main class=\"front-main\">\r\n      <router-view />\r\n    </main>\r\n\r\n    <footer class=\"site-footer\">\r\n      <div class=\"footer-inner\">\r\n        <span class=\"footer-brand\">{{ $sysTitle }}</span>\r\n        <span class=\"footer-copy\">Copyright © {{ year }} All Rights Reserved</span>\r\n      </div>\r\n    </footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapMutations } from 'vuex'\r\nimport { removeToken } from '@/utils/auth'\r\n\r\nexport default {\r\n  name: 'FrontLayout',\r\n  data() {\r\n    return {\r\n      head: '',\r\n      year: '',\r\n      navItems: [\r\n        { path: '/front', label: '首页' },\r\n        { path: '/front/room', label: '预约入住' },\r\n        { path: '/front/notice', label: '系统公告' },\r\n        { path: '/front/message', label: '用户留言' }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    ...mapState(['user', 'role', 'token'])\r\n  },\r\n  mounted() {\r\n    this.year = new Date().getFullYear()\r\n    this.head = this.user?.head\r\n  },\r\n  methods: {\r\n    ...mapMutations(['setUser', 'setRole', 'setToken']),\r\n    isActive(path) {\r\n      if (path === '/front') {\r\n        return this.$route.path === '/front' || this.$route.path === '/front/'\r\n      }\r\n      return this.$route.path.startsWith(path)\r\n    },\r\n    handleCommand(cmd) {\r\n      const routes = {\r\n        userInfo: '/front/userInfo',\r\n        appointment: '/front/appointment',\r\n        orders: '/front/orders'\r\n      }\r\n      if (cmd === 'logout') {\r\n        this.logout()\r\n      } else if (routes[cmd]) {\r\n        this.$router.push(routes[cmd])\r\n      }\r\n    },\r\n    logout() {\r\n      this.$confirm('确定退出吗?', '温馨提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        removeToken()\r\n        this.setUser({})\r\n        this.setToken('')\r\n        this.$router.replace('/front')\r\n      }).catch(() => {})\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n@gold: #c9a962;\r\n@dark: #141820;\r\n\r\n.front-layout {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: #f5f6f8;\r\n}\r\n\r\n.site-header {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 1000;\r\n  background: rgba(20, 24, 32, 0.92);\r\n  backdrop-filter: blur(12px);\r\n  border-bottom: 1px solid rgba(201, 169, 98, 0.15);\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);\r\n}\r\n\r\n.header-inner {\r\n  max-width: 1280px;\r\n  margin: 0 auto;\r\n  height: 64px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 24px;\r\n}\r\n\r\n.brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  cursor: pointer;\r\n  flex-shrink: 0;\r\n\r\n  .brand-logo {\r\n    width: 38px;\r\n    height: 38px;\r\n    object-fit: contain;\r\n  }\r\n\r\n  .brand-info {\r\n    display: flex;\r\n    flex-direction: column;\r\n  }\r\n\r\n  .brand-name {\r\n    font-size: 16px;\r\n    font-weight: 600;\r\n    color: #fff;\r\n    letter-spacing: 0.5px;\r\n    line-height: 1.2;\r\n  }\r\n\r\n  .brand-tagline {\r\n    font-size: 11px;\r\n    color: @gold;\r\n    letter-spacing: 2px;\r\n    margin-top: 2px;\r\n  }\r\n}\r\n\r\n.main-nav {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n.nav-item {\r\n  padding: 8px 18px;\r\n  font-size: 14px;\r\n  color: rgba(255, 255, 255, 0.72);\r\n  border-radius: 6px;\r\n  transition: all 0.2s;\r\n  text-decoration: none;\r\n\r\n  &:hover {\r\n    color: #fff;\r\n    background: rgba(255, 255, 255, 0.08);\r\n  }\r\n\r\n  &.active {\r\n    color: @gold;\r\n    background: rgba(201, 169, 98, 0.12);\r\n    font-weight: 500;\r\n  }\r\n}\r\n\r\n.header-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.btn-ghost {\r\n  padding: 7px 18px;\r\n  font-size: 14px;\r\n  color: rgba(255, 255, 255, 0.85);\r\n  border: 1px solid rgba(255, 255, 255, 0.25);\r\n  border-radius: 6px;\r\n  transition: all 0.2s;\r\n  text-decoration: none;\r\n\r\n  &:hover {\r\n    border-color: @gold;\r\n    color: @gold;\r\n  }\r\n}\r\n\r\n.btn-gold {\r\n  padding: 7px 18px;\r\n  font-size: 14px;\r\n  color: @dark;\r\n  background: linear-gradient(135deg, @gold, #a88b4a);\r\n  border-radius: 6px;\r\n  font-weight: 500;\r\n  transition: all 0.2s;\r\n  text-decoration: none;\r\n\r\n  &:hover {\r\n    box-shadow: 0 4px 12px rgba(201, 169, 98, 0.4);\r\n    transform: translateY(-1px);\r\n  }\r\n}\r\n\r\n.user-pill {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 4px 12px 4px 4px;\r\n  border-radius: 24px;\r\n  background: rgba(255, 255, 255, 0.08);\r\n  cursor: pointer;\r\n  transition: background 0.2s;\r\n  color: #fff;\r\n  font-size: 14px;\r\n\r\n  &:hover { background: rgba(255, 255, 255, 0.14); }\r\n\r\n  .user-avatar-img {\r\n    width: 32px;\r\n    height: 32px;\r\n    border-radius: 50%;\r\n    object-fit: cover;\r\n  }\r\n\r\n  i { font-size: 12px; color: rgba(255, 255, 255, 0.5); }\r\n}\r\n\r\n.front-main {\r\n  flex: 1;\r\n  padding-top: 64px;\r\n  min-height: calc(100vh - 64px);\r\n}\r\n\r\n.site-footer {\r\n  background: @dark;\r\n  border-top: 1px solid rgba(201, 169, 98, 0.12);\r\n  padding: 24px;\r\n}\r\n\r\n.footer-inner {\r\n  max-width: 1280px;\r\n  margin: 0 auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n\r\n.footer-brand {\r\n  font-size: 14px;\r\n  color: @gold;\r\n  font-weight: 500;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.footer-copy {\r\n  font-size: 12px;\r\n  color: rgba(255, 255, 255, 0.4);\r\n}\r\n</style>\r\n"],"mappings":";AA2DA,SAAAA,QAAA,EAAAC,YAAA;AACA,SAAAC,WAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;MACAC,IAAA;MACAC,QAAA,GACA;QAAAC,IAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,IAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,IAAA;QAAAC,KAAA;MAAA,GACA;QAAAD,IAAA;QAAAC,KAAA;MAAA;IAEA;EACA;EACAC,QAAA;IACA,GAAAV,QAAA;EACA;EACAW,QAAA;IACA,KAAAL,IAAA,OAAAM,IAAA,GAAAC,WAAA;IACA,KAAAR,IAAA,QAAAS,IAAA,EAAAT,IAAA;EACA;EACAU,OAAA;IACA,GAAAd,YAAA;IACAe,SAAAR,IAAA;MACA,IAAAA,IAAA;QACA,YAAAS,MAAA,CAAAT,IAAA,sBAAAS,MAAA,CAAAT,IAAA;MACA;MACA,YAAAS,MAAA,CAAAT,IAAA,CAAAU,UAAA,CAAAV,IAAA;IACA;IACAW,cAAAC,GAAA;MACA,MAAAC,MAAA;QACAC,QAAA;QACAC,WAAA;QACAC,MAAA;MACA;MACA,IAAAJ,GAAA;QACA,KAAAK,MAAA;MACA,WAAAJ,MAAA,CAAAD,GAAA;QACA,KAAAM,OAAA,CAAAC,IAAA,CAAAN,MAAA,CAAAD,GAAA;MACA;IACA;IACAK,OAAA;MACA,KAAAG,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;MACA,GAAAC,IAAA;QACA9B,WAAA;QACA,KAAA+B,OAAA;QACA,KAAAC,QAAA;QACA,KAAAR,OAAA,CAAAS,OAAA;MACA,GAAAC,KAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}