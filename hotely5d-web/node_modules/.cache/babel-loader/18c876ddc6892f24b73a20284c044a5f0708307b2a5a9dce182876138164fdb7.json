{"ast":null,"code":"import { modifyAdminAPI } from \"@/api/admin\";\nimport { mapMutations } from 'vuex';\nimport { getUserInfoByTokenAPI } from '@/api/system';\nexport default {\n  name: 'Hotely5dWebAdminInfo',\n  data() {\n    return {\n      form: {},\n      genderOptions: [{\n        label: '男',\n        value: 1\n      }, {\n        label: '女',\n        value: 2\n      }]\n    };\n  },\n  async mounted() {\n    //请求用户信息\n    const result = await getUserInfoByTokenAPI();\n    this.form = result.data;\n  },\n  methods: {\n    ...mapMutations(['setUser']),\n    async handleModify() {\n      const res = await modifyAdminAPI(this.form);\n      this.$message({\n        message: res.message,\n        type: res.flag ? \"success\" : \"error\"\n      });\n      if (res.flag) {\n        this.setUser(this.form);\n        setTimeout(() => {\n          this.$router.go(0);\n        }, 1000);\n      }\n    }\n  }\n};","map":{"version":3,"names":["modifyAdminAPI","mapMutations","getUserInfoByTokenAPI","name","data","form","genderOptions","label","value","mounted","result","methods","handleModify","res","$message","message","type","flag","setUser","setTimeout","$router","go"],"sources":["src/views/AdminInfo.vue"],"sourcesContent":["<template>\r\n    <div class=\"page-container\">\r\n        <el-card class=\"box-card\">\r\n            <div slot=\"header\" class=\"clearfix\">\r\n                <span>个人信息</span>\r\n            </div>\r\n            <el-form label-position=\"left\" :model=\"form\" label-width=\"80px\">\r\n                <el-form-item label=\"账号\">\r\n                    <el-input disabled  v-model=\"form.username\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"密码\">\r\n                    <el-input type=\"password\" placeholder=\"请输入密码\" v-model=\"form.password\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"姓名\">\r\n                    <el-input placeholder=\"请输入姓名\" v-model=\"form.name\" autocomplete=\"off\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"性别\">\r\n                    <el-select v-model=\"form.gender\" placeholder=\"请选择\">\r\n                        <el-option v-for=\"item in genderOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\r\n                        </el-option>\r\n                    </el-select>\r\n                </el-form-item>\r\n                <el-form-item>\r\n                    <el-button type=\"primary\" @click=\"handleModify\">修改</el-button>\r\n                </el-form-item>\r\n            </el-form>\r\n        </el-card>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport { modifyAdminAPI } from \"@/api/admin\";\r\nimport { mapMutations } from 'vuex'\r\nimport { getUserInfoByTokenAPI } from '@/api/system'\r\nexport default {\r\n    name: 'Hotely5dWebAdminInfo',\r\n\r\n    data() {\r\n        return {\r\n            form: {},\r\n            genderOptions: [\r\n                {\r\n                    label: '男',\r\n                    value: 1\r\n                },\r\n                {\r\n                    label: '女',\r\n                    value: 2\r\n                }\r\n            ],\r\n        };\r\n    },\r\n\r\n    async mounted() {\r\n        //请求用户信息\r\n        const result = await getUserInfoByTokenAPI()\r\n        this.form = result.data\r\n    },\r\n\r\n    methods: {\r\n        ...mapMutations(['setUser']),\r\n        async handleModify() {\r\n            const res = await modifyAdminAPI(this.form);\r\n\r\n            this.$message({\r\n                message: res.message,\r\n                type: res.flag ? \"success\" : \"error\",\r\n            });\r\n            if (res.flag) {\r\n                this.setUser(this.form)\r\n                setTimeout(() => {\r\n                    this.$router.go(0)\r\n                }, 1000);\r\n            }\r\n\r\n        },\r\n    },\r\n};\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.page-container {\r\n    width: 600px;\r\n    margin: 20px auto;\r\n}\r\n</style>"],"mappings":"AA+BA,SAAAA,cAAA;AACA,SAAAC,YAAA;AACA,SAAAC,qBAAA;AACA;EACAC,IAAA;EAEAC,KAAA;IACA;MACAC,IAAA;MACAC,aAAA,GACA;QACAC,KAAA;QACAC,KAAA;MACA,GACA;QACAD,KAAA;QACAC,KAAA;MACA;IAEA;EACA;EAEA,MAAAC,QAAA;IACA;IACA,MAAAC,MAAA,SAAAR,qBAAA;IACA,KAAAG,IAAA,GAAAK,MAAA,CAAAN,IAAA;EACA;EAEAO,OAAA;IACA,GAAAV,YAAA;IACA,MAAAW,aAAA;MACA,MAAAC,GAAA,SAAAb,cAAA,MAAAK,IAAA;MAEA,KAAAS,QAAA;QACAC,OAAA,EAAAF,GAAA,CAAAE,OAAA;QACAC,IAAA,EAAAH,GAAA,CAAAI,IAAA;MACA;MACA,IAAAJ,GAAA,CAAAI,IAAA;QACA,KAAAC,OAAA,MAAAb,IAAA;QACAc,UAAA;UACA,KAAAC,OAAA,CAAAC,EAAA;QACA;MACA;IAEA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}